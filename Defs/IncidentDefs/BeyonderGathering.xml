<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- Торговый ассортимент -->
    <TraderKindDef>
        <defName>BeyonderGatheringTrader</defName>
        <label>beyonder gathering</label>

        <stockGenerators>
            <!-- Серебро торговца -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>500~1500</countRange>
            </li>

            <!-- Базовые товары -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>lotr_MagicalHerbs</thingDef>
                <countRange>1~3</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>lotr_MysticalComponents</thingDef>
                <countRange>0~2</countRange>
            </li>

            <!-- Торговец покупает потусторонние ингредиенты -->
            <li Class="StockGenerator_BuyTradeTag">
                <tag>BeyonderTrading</tag>
            </li>
        </stockGenerators>
    </TraderKindDef>

    <!-- Мировой объект -->
    <WorldObjectDef ParentName="StaticWorldObjectBase">
        <defName>BeyonderGatheringSite</defName>
        <label>beyonder gathering</label>
        <description>A mysterious gathering of beyonders. You can trade here.</description>

        <texture>World/WorldObjects/Sites/GenericSite</texture>
        <expandingIcon>true</expandingIcon>
        <expandingIconTexture>World/WorldObjects/Sites/GenericSite</expandingIconTexture>
        <expandingIconPriority>70</expandingIconPriority>

        <canHaveMap>false</canHaveMap>

        <comps>
            <li Class="lotr.WorldObjectCompProperties_BeyonderGatheringTrader" />
        </comps>

        <modExtensions>
            <li Class="lotr.BeyonderGatheringExtension">
                <traderKindDef>BeyonderGatheringTrader</traderKindDef>
            </li>
        </modExtensions>
    </WorldObjectDef>

    <!-- Инцидент -->
    <IncidentDef>
        <defName>BeyonderGathering_Incident</defName>
        <label>beyonder gathering</label>
        <baseChance>2.0</baseChance>
        <workerClass>lotr.IncidentWorker_BeyonderGathering</workerClass>
        <category>Misc</category>
        <earliestDay>10</earliestDay>

        <letterLabel>Beyonder gathering</letterLabel>
        <letterText>A mysterious beyonder gathering has appeared near your base. They are willing to trade.</letterText>
        <letterDef>PositiveEvent</letterDef>

        <targetTags>
            <li>World</li>
        </targetTags>
    </IncidentDef>

</Defs>