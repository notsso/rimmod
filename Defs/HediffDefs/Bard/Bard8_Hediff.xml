                <capMods>
                    <li><capacity>Sight</capacity><offset>0.10</offset></li>
                    <li><capacity>Moving</capacity><offset>0.10</offset></li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.4</minSeverity>
                <label>fin</label>
                <statFactors>
                    <IncomingDamageFactor>0.92</IncomingDamageFactor>
                </statFactors>
                <statOffsets>
                    <PsychicSensitivity>0.50</PsychicSensitivity>
                    <SocialImpact>0.35</SocialImpact>
                    <MentalBreakThreshold>-0.15</MentalBreakThreshold>
                    <ArmorRating_Heat>0.15</ArmorRating_Heat>
                </statOffsets>
                <capMods>
                    <li><capacity>Sight</capacity><offset>0.15</offset></li>
                    <li><capacity>Moving</capacity><offset>0.15</offset></li>
                    <li><capacity>BloodPumping</capacity><offset>0.15</offset></li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.8</minSeverity>
                <label>pro</label>
                <statFactors>
                    <IncomingDamageFactor>0.90</IncomingDamageFactor>
                </statFactors>
