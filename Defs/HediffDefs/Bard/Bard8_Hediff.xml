                    <MeleeHitChance>2</MeleeHitChance>
					<MeleeDodgeChance>2</MeleeDodgeChance>
					<ShootingAccuracyPawn>2</ShootingAccuracyPawn>
                    <PsychicSensitivity>0.70</PsychicSensitivity>
                    <SocialImpact>0.50</SocialImpact>
                    <MentalBreakThreshold>-0.20</MentalBreakThreshold>
                    <ArmorRating_Heat>0.20</ArmorRating_Heat>
                </statOffsets>
                <capMods>
                    <li><capacity>Sight</capacity><offset>0.20</offset></li>
                    <li><capacity>Moving</capacity><offset>0.20</offset></li>
                    <li><capacity>BloodPumping</capacity><offset>0.20</offset></li>
                </capMods>
            </li>
        </stages>

        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>0.03</severityPerDay>
            </li>
        </comps>

        <newAbilities />
