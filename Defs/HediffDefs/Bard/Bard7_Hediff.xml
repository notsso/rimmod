        <isBad>false</isBad>

        <stages>
            <li>
                <minSeverity>0.0</minSeverity>
                <label>лох</label>
                <statFactors>
                    <IncomingDamageFactor>0.95</IncomingDamageFactor>
                </statFactors>
                <statOffsets>
                    <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
                    <ArmorRating_Blunt>0.05</ArmorRating_Blunt>
                    <ArmorRating_Heat>0.05</ArmorRating_Heat>

                    <PsychicSensitivity>0.30</PsychicSensitivity>
                    <SocialImpact>0.30</SocialImpact>
                    <MentalBreakThreshold>-0.10</MentalBreakThreshold>
                    <ArmorRating_Heat>0.15</ArmorRating_Heat>
                    <ToxicResistance>0.15</ToxicResistance>
                    <InjuryHealingFactor>0.2</InjuryHealingFactor>
                </statOffsets>
                <capMods>
                    <li><capacity>Moving</capacity><offset>0.05</offset></li>
                    <li><capacity>Sight</capacity><offset>0.05</offset></li>
                    <li><capacity>Talking</capacity><offset>0.10</offset></li>
                    <li><capacity>Consciousness</capacity><offset>0.05</offset></li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.4</minSeverity>
                <label>нормик</label>
                <statFactors>
                    <IncomingDamageFactor>0.95</IncomingDamageFactor>
                </statFactors>
                <statOffsets>
                    <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
                    <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
                    <ArmorRating_Heat>0.10</ArmorRating_Heat>

                    <PsychicSensitivity>0.50</PsychicSensitivity>
                    <SocialImpact>0.40</SocialImpact>
                    <MentalBreakThreshold>-0.15</MentalBreakThreshold>
                    <ToxicResistance>0.20</ToxicResistance>
                    <InjuryHealingFactor>0.3</InjuryHealingFactor>
                </statOffsets>
                <capMods>
                    <li><capacity>Moving</capacity><offset>0.05</offset></li>
                    <li><capacity>Sight</capacity><offset>0.05</offset></li>
                    <li><capacity>Talking</capacity><offset>0.10</offset></li>
                    <li><capacity>Consciousness</capacity><offset>0.10</offset></li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.8</minSeverity>
                <label>смешарик</label>
                <statFactors>
                    <IncomingDamageFactor>0.90</IncomingDamageFactor>
                </statFactors>
                <statOffsets>
                    <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
                    <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
                    <ArmorRating_Heat>0.15</ArmorRating_Heat>

                    <PsychicSensitivity>0.70</PsychicSensitivity>
                    <SocialImpact>0.50</SocialImpact>
                    <MentalBreakThreshold>-0.20</MentalBreakThreshold>
                    <ToxicResistance>0.25</ToxicResistance>
                    <InjuryHealingFactor>0.4</InjuryHealingFactor>
                </statOffsets>
                <capMods>
                    <li><capacity>Moving</capacity><offset>0.05</offset></li>
                    <li><capacity>Sight</capacity><offset>0.05</offset></li>
                    <li><capacity>Talking</capacity><offset>0.10</offset></li>
                    <li><capacity>Consciousness</capacity><offset>0.15</offset></li>
                </capMods>
            </li>
