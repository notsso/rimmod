<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <lotr.BeyonderHediffDef Class="lotr.BeyonderHediffDef">
        <hediffClass>lotr.Bard7_Hediff</hediffClass>
        <defName>Bard7_Hediff</defName>
        <label>Sun High Priest</label>
        <sequence>7</sequence>
        <pathway>Bard</pathway>

        <spiritualityOffset>2.0</spiritualityOffset>

        <description>This person became 7 sequence beyonder - sun high priest.</description>
        <defaultLabelColor>(1.0, 0.8, 0.0)</defaultLabelColor>
        <initialSeverity>0.01</initialSeverity>
        <maxSeverity>1</maxSeverity>
        <minSeverity>0</minSeverity>
