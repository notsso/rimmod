<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <HediffDef>
        <defName>SunsetLightDebuff</defName>
        <label>sunset light radiance</label>
        <description>This pawn is suffering from sunset light.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(255, 120, 0)</defaultLabelColor>
        <isBad>true</isBad>
        <stages>
        <li>
            <label>weakness</label>
            <minSeverity>0</minSeverity>
            <painOffset>0.2</painOffset>
            <capMods>
                <li>
                    <capacity>Moving</capacity>
                    <offset>-0.25</offset>
                </li>
                <li>
                    <capacity>Consciousness</capacity>
                    <offset>-0.15</offset>
                </li>
            </capMods>
            <statOffsets>
                <MeleeHitChance>-15</MeleeHitChance>
                <MeleeDodgeChance>-15</MeleeDodgeChance>
                <ShootingAccuracyPawn>-0.25</ShootingAccuracyPawn>
            </statOffsets>
        </li>
        </stages>
        <comps>
        <li Class="HediffCompProperties_Disappears">
            <disappearsAfterTicks>2500</disappearsAfterTicks>
            <showRemainingTime>true</showRemainingTime>
        </li>
        </comps>
    </HediffDef>
</Defs>
