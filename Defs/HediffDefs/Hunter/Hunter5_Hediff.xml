<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <lotr.BeyonderHediffDef Class="lotr.BeyonderHediffDef">

        <hediffClass>lotr.Hunter5_Hediff</hediffClass>
        <defName>Hunter5_Hediff</defName>

        <label>Reaper</label>
        <sequence>5</sequence>
        <pathway>Hunter</pathway>

        <spiritualityOffset>4</spiritualityOffset>

        <description>This person became 5 sequence beyonder - reaper. This person sees vulnerabilities and can reap souls.</description>
