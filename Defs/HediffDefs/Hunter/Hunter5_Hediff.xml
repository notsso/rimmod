        <initialSeverity>0.01</initialSeverity>
        <maxSeverity>1</maxSeverity>
        <minSeverity>0</minSeverity>
        <tendable>false</tendable>
        <isBad>false</isBad>

        <stages>
            <li>
                <minSeverity>0.0</minSeverity>
                <label>лох</label>

                <statFactors>
                    <IncomingDamageFactor>0.90</IncomingDamageFactor>
                    <Flammability>0</Flammability>
                </statFactors>

                <statOffsets>
                    <ArmorRating_Sharp>0.1</ArmorRating_Sharp>
                    <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
                    <ArmorRating_Heat>0.2</ArmorRating_Heat>

                    <MeleeHitChance>4</MeleeHitChance>
                    <MeleeDodgeChance>2</MeleeDodgeChance>
                    <ShootingAccuracyPawn>2</ShootingAccuracyPawn>
                    
                    <GeneralLaborSpeed>0.2</GeneralLaborSpeed>
                    <InjuryHealingFactor>0.5</InjuryHealingFactor>

                    <SocialImpact>0.10</SocialImpact>
                    <TradePriceImprovement>0.10</TradePriceImprovement>
                    <PsychicSensitivity>0.10</PsychicSensitivity>
                    <MentalBreakThreshold>-0.05</MentalBreakThreshold>
                    <TrapSpringChance>-0.10</TrapSpringChance>

                    <ResearchSpeed>0.20</ResearchSpeed>
                    <GlobalLearningFactor>0.20</GlobalLearningFactor>

                    <MeleeDamageFactor>0.30</MeleeDamageFactor>
                </statOffsets>

                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>0.2</offset>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>0.2</offset>
                    </li>
                    <li>
                        <capacity>BloodPumping</capacity>
                        <offset>0.4</offset>
                    </li>
                    <li>
                        <capacity>Talking</capacity>
                        <offset>0.10</offset>
                    </li>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.20</offset>
                    </li>
                </capMods>
            </li>

            <li>
                <minSeverity>0.4</minSeverity>
                <label>нормик</label>

                <statFactors>
                    <IncomingDamageFactor>0.75</IncomingDamageFactor>
                    <Flammability>0</Flammability>
                </statFactors>
                
                <statOffsets>
                    <ArmorRating_Sharp>0.3</ArmorRating_Sharp>
                    <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
                    <ArmorRating_Heat>0.5</ArmorRating_Heat>

                    <MeleeHitChance>6</MeleeHitChance>
                    <MeleeDodgeChance>6</MeleeDodgeChance>
                    <ShootingAccuracyPawn>6</ShootingAccuracyPawn>
                    
                    <GeneralLaborSpeed>0.50</GeneralLaborSpeed>
                    <InjuryHealingFactor>1.0</InjuryHealingFactor>
                    
                    <SocialImpact>0.15</SocialImpact>
                    <TradePriceImprovement>0.15</TradePriceImprovement>
                    <PsychicSensitivity>0.30</PsychicSensitivity>
                    <MentalBreakThreshold>-0.15</MentalBreakThreshold>
                    <TrapSpringChance>-0.20</TrapSpringChance>
                    
                    <ResearchSpeed>0.40</ResearchSpeed>
                    <GlobalLearningFactor>0.50</GlobalLearningFactor>

                    <MeleeDamageFactor>0.50</MeleeDamageFactor>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>0.30</offset>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>0.30</offset>
                    </li>
                    <li>
                        <capacity>BloodPumping</capacity>
                        <offset>0.50</offset>
