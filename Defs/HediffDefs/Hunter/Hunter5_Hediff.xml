                    <li>
                        <capacity>Talking</capacity>
                        <offset>0.20</offset>
                    </li>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.40</offset>
                    </li>
                </capMods>
            </li>

            <li>
                <minSeverity>0.8</minSeverity>
                <label>смешарик</label>

                <statFactors>
                    <IncomingDamageFactor>0.60</IncomingDamageFactor>
                    <Flammability>0</Flammability>
                </statFactors>
                
