                    <MeleeDamageFactor>0.60</MeleeDamageFactor>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>0.50</offset>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>0.50</offset>
                    </li>
                    <li>
                        <capacity>BloodPumping</capacity>
                        <offset>0.50</offset>
                    </li>
                    <li>
                        <capacity>Talking</capacity>
                        <offset>0.50</offset>
                    </li>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.5</offset>
                    </li>
                </capMods>
            </li>
        </stages>

        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>0.005</severityPerDay>
            </li>
        </comps>

        <newAbilities>

            <li>Cast_Execution</li>
            <li>Cast_Vulnerability</li> 

        </newAbilities>

    </lotr.BeyonderHediffDef>

</Defs>