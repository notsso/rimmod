					<li>
						<capacity>Moving</capacity>
						<offset>0.08</offset>
					</li>
					<li>
						<capacity>Sight</capacity>
						<offset>0.08</offset>
					</li>
					<li>
						<capacity>BloodPumping</capacity>
						<offset>0.08</offset> 
					</li>
				</capMods>
			</li>
			
            <li>
				<minSeverity>0.8</minSeverity>
				<label>pro</label>

                <statFactors>
					<IncomingDamageFactor>0.85</IncomingDamageFactor> 
				</statFactors>

				<statOffsets>
                    <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
