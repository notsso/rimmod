<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>FragileRegeneratedPart</defName>
    <label>fragile regrown part</label>
    <description>A newly regenerated body part that is still fragile and tender. It does not heal naturally.</description>
    
    <!-- Путь к вашему классу. Убедитесь, что namespace совпадает -->
    <hediffClass>lotr.Hediff_BodyPartGrowth</hediffClass>
    
    <isBad>true</isBad>
    <tendable>true</tendable>
    <defaultLabelColor>(1.0, 0.8, 0.6, 1)</defaultLabelColor>
    
    <!-- Стадии только для отображения, не для логики -->
    <stages>
      <li>
        <label>fragile</label>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <label>tender</label>
        <minSeverity>0.25</minSeverity>
      </li>
      <li>
        <label>healing</label>
        <minSeverity>0.5</minSeverity>
      </li>
      <li>
        <label>recovering</label>
        <minSeverity>0.75</minSeverity>
      </li>
    </stages>
  </HediffDef>
</Defs>