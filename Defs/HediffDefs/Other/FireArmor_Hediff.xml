    <HediffDef Name="Hediff_FireArmor">
        
        <hediffClass>lotr.Hediff_FireLight</hediffClass>

        <defName>Hediff_FireArmor</defName>
        <label>огненный покров</label>
        <description>Тело пешки окутано мистическим пламенем, защищающим от внешних угроз.</description>
