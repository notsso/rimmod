<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <HediffDef Name="Hediff_FireArmor">
        <defName>Hediff_FireArmor</defName>
        <label>огненный покров</label>
        <description>Тело пешки окутано мистическим пламенем, защищающим от внешних угроз.</description>
        <hediffClass>lotr.Hediff_FireArmor</hediffClass>
        <isBad>false</isBad>
    </HediffDef>

    <!-- Уровень 7 -->
    <HediffDef ParentName="Hediff_FireArmor">
        <defName>Hediff_FireArmor_7S</defName>
        <label>огненный покров</label>

        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>3600</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>

        <stages>
            <li>
                <statOffsets>
                    <ArmorRating_Sharp>0.80</ArmorRating_Sharp>
                    <ArmorRating_Blunt>0.60</ArmorRating_Blunt>
                    <ArmorRating_Heat>1.50</ArmorRating_Heat> 
                    <ComfyTemperatureMin>-100</ComfyTemperatureMin>
                </statOffsets>
                
                <statFactors>
                    <ToxicResistance>0.0</ToxicResistance>
                </statFactors>
            </li>
        </stages>
    </HediffDef>

    <!-- Уровень 6 -->
    <HediffDef ParentName="Hediff_FireArmor">
        <defName>Hediff_FireArmor_6S</defName>
        <label>огненный покров</label>

        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>6000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>

        <stages>
            <li>
                <statOffsets>
                    <ArmorRating_Sharp>1.00</ArmorRating_Sharp>
                    <ArmorRating_Blunt>1.00</ArmorRating_Blunt>
                    <ArmorRating_Heat>2.00</ArmorRating_Heat> 
                    <ComfyTemperatureMin>-150</ComfyTemperatureMin>
                </statOffsets>
                
                <statFactors>
                    <ToxicResistance>0.0</ToxicResistance>
                </statFactors>
            </li>
        </stages>
    </HediffDef>

</Defs>