<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <HediffDef>

        <hediffClass>lotr.SanityLoss</hediffClass>
        <defName>lotr_SanityLoss</defName>
        <label>искажение разума</label>
        <description>Потусторонняя энергия Сиквенций выходит из-под контроля, разрушая человеческий разум и перестраивая плоть. Если тяжесть дойдет до максимума, пешка окончательно потеряет человечность.</description>
        <!-- Пурпурный магический цвет текста в интерфейсе здоровья -->
        <defaultLabelColor>(0.7, 0.2, 0.8)</defaultLabelColor>
        <initialSeverity>0.01</initialSeverity>
        <maxSeverity>1.0</maxSeverity>
        <minSeverity>0</minSeverity>
        <tendable>false</tendable>
        <isBad>true</isBad> <!-- Игра считает это тяжелой болезнью -->
        
        <stages>
            <li>
                <minSeverity>0.0</minSeverity>
                <label>иллюзии</label>
                <!-- Пешка начинает хуже соображать из-за голосов в голове -->
                <statOffsets>
                <MentalBreakThreshold>0.08</MentalBreakThreshold> <!-- Повышает порог нервного срыва на 8% -->
                </statOffsets>
                <capMods>
                <li>
                    <capacity>Consciousness</capacity>
                    <offset>-0.05</offset> <!-- Сознание -5% -->
                </li>
                </capMods>
            </li>

            <li>
                <minSeverity>0.4</minSeverity>
                <label>одержимость</label>
                <statOffsets>
                <MentalBreakThreshold>0.20</MentalBreakThreshold> <!-- Порог срыва повышается на 20%! -->
                <MeleeHitChance>2</MeleeHitChance> <!-- Безумная ярость помогает драться вблизи -->
                </statOffsets>
                <capMods>
                <li>
                    <capacity>Consciousness</capacity>
                    <offset>-0.15</offset> <!-- Сознание -15% -->
                </li>
                <li>
                    <capacity>Manipulation</capacity>
                    <offset>-0.10</offset> <!-- Руки начинают дрожать, работа замедляется -->
                </li>
                </capMods>
            </li>

            <li>
                <minSeverity>0.7</minSeverity>
                <label>мутация плоти</label>
                <!-- Человеческий разум почти угас, тело перестраивается в монстра -->
                <statFactors>
                <IncomingDamageFactor>0.75</IncomingDamageFactor> <!-- Из-за мутировавшей кожи получает на 25% меньше урона -->
                </statFactors>
                <statOffsets>
                <MeleeHitChance>6</MeleeHitChance>
                <MoveSpeed>0.5</MoveSpeed> <!-- Скорость бега увеличивается (звериные инстинкты) -->
                </statOffsets>
                <capMods>
                <li>
                    <capacity>Consciousness</capacity>
                    <offset>-0.40</offset> <!-- Пешка едва соображает, что делает -->
                </li>
                <li>
                    <capacity>Talking</capacity>
                    <offset>-0.80</offset> <!-- Способность говорить почти полностью утрачена -->
                </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

</Defs>