<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <HediffDef>

        <hediffClass>lotr.Hediff_SanityLoss</hediffClass>
        <defName>lotr_SanityLoss</defName>
        <label>sanity loss</label>
        <description>The otherworldly energy is spiraling out of control, destroying the human mind and reshaping flesh. If the gravity reaches its maximum, the pawn will completely lose their humanity.</description>

        <defaultLabelColor>(0.7, 0.2, 0.8)</defaultLabelColor>
        <initialSeverity>0.01</initialSeverity>
        <maxSeverity>1.0</maxSeverity>
        <minSeverity>0</minSeverity>
        <tendable>false</tendable>
        <isBad>true</isBad>
        
        <stages>
            <li>
                <minSeverity>0.0</minSeverity>
                <label>illusions</label>
                <statOffsets>
                    <MentalBreakThreshold>0.08</MentalBreakThreshold>
                </statOffsets>
                <capMods>
                <li>
                    <capacity>Consciousness</capacity>
                    <offset>-0.05</offset>
                </li>
                </capMods>
            </li>

            <li>
                <minSeverity>0.4</minSeverity>
                <label>obsession</label>
                <statOffsets>
                    <MentalBreakThreshold>0.20</MentalBreakThreshold>
                    <MeleeHitChance>2</MeleeHitChance>
                </statOffsets>
                <capMods>
                <li>
                    <capacity>Consciousness</capacity>
                    <offset>-0.15</offset>
                </li>
                <li>
                    <capacity>Manipulation</capacity>
                    <offset>-0.10</offset>
                </li>
                </capMods>
            </li>

            <li>
                <minSeverity>0.7</minSeverity>
                <label>flesh mutation</label>
                <statFactors>
                    <IncomingDamageFactor>0.75</IncomingDamageFactor>
                </statFactors>
                <statOffsets>
                    <MeleeHitChance>6</MeleeHitChance>
                    <MoveSpeed>0.5</MoveSpeed>
                </statOffsets>
                <capMods>
                <li>
                    <capacity>Consciousness</capacity>
                    <offset>-0.40</offset>
                </li>
                <li>
                    <capacity>Talking</capacity>
                    <offset>-0.80</offset>
                </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

</Defs>