<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <AbilityDef Class="lotr.BeyonderAbilityDef" Name="Cast_Firewave">

        <abilityClass>lotr.Ability_SpendSpirituality</abilityClass>
        
        <defName>Cast_Firewave</defName>
