<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="BaseBullet">

        <defName>Proj_BlazingSpear</defName>
        <label>Копье огня</label>
        <thingClass>lotr.Projectile_BlazingSpear</thingClass>

        <graphicData>

            <texPath>Projectiles/BlazingSpear_projectile</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>TransparentPostLight</shaderType>

            <color>(255, 150, 50)</color>

            <drawSize>(1.0, 2.0)</drawSize> 

        </graphicData>

        <projectile>

            <speed>120</speed>
            <damageDef>Burn</damageDef>
            <damageAmountBase>40</damageAmountBase>
            <armorPenetrationBase>3.00</armorPenetrationBase>
            <explosionRadius>1.6</explosionRadius>
            <ai_IsIncendiary>true</ai_IsIncendiary>

            <postExplosionSpawnThingDef>Filth_Fuel</postExplosionSpawnThingDef>
            <postExplosionSpawnChance>1.0</postExplosionSpawnChance>
            <postExplosionSpawnThingCount>1</postExplosionSpawnThingCount>
            <explosionChanceToStartFire>1.0</explosionChanceToStartFire>
            
        </projectile>

    </ThingDef>

    <AbilityDef>
    
        <abilityClass>lotr.Ability_SpendSpirituality</abilityClass>
        <defName>Cast_BlazingSpear</defName>
        <label>Копье огня</label>
        <description>Создание и бросок сверхмощного, сжатого снаряда из пламени, который пробивает броню и взрывается при попадании.</description>
        <iconPath>UI/Icons/Abilities/Hunter/BlazingSpear</iconPath>
        <cooldownTicksRange>1200</cooldownTicksRange>
        <hostile>true</hostile>

        <modExtensions>
            <li Class="lotr.SpiritualityCostExtension">
                <cost>100.0</cost>
            </li>
        </modExtensions>

        <comps>
            <li Class="CompProperties_AbilityLaunchProjectile">
                <projectileDef>Proj_BlazingSpear</projectileDef>
            </li>
        </comps>

        <verbProperties>

            <verbClass>Verb_CastAbility</verbClass>
            <range>40</range>
            <warmupTime>2.5</warmupTime>
            <hasStandardCommand>true</hasStandardCommand>

            <targetParams>

                <canTargetLocations>true</canTargetLocations>
                <canTargetPawns>true</canTargetPawns>
                <canTargetBuildings>true</canTargetBuildings>

            </targetParams>

        </verbProperties>

    </AbilityDef>

</Defs>