<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <AbilityDef>

        <abilityClass>lotr.Ability_SpendSpirituality</abilityClass>
        <defName>Provoking</defName>
        <label>провокация</label>
        <description>Привлекает внимание противника, заставляя его атаковать вас в ближнем бою.</description>
        <iconPath>UI/Icons/Abilities/Hunter/Provoking</iconPath> <!-- Путь к вашей иконке -->
        <cooldownTicksRange>1200</cooldownTicksRange> <!-- Перезарядка 20 секунд (1200 тиков) -->
        <aiCanUse>true</aiCanUse>
        <targetRequired>true</targetRequired>

        <modExtensions>
            <li Class="lotr.SpiritualityCostExtension">
                <cost>20.0</cost>
            </li>
        </modExtensions>
        
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <range>15.9</range> <!-- Дистанция применения -->
            <warmupTime>0.2</warmupTime> <!-- Время каста -->
            <targetParams>
                <canTargetPawns>true</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetMechs>true</canTargetMechs>
                <canTargetAnimals>true</canTargetAnimals>
            </targetParams>
        </verbProperties>

        <comps>
            <li Class="lotr.CompProperties_AbilityProvoke" />
        </comps>

    </AbilityDef>

</Defs>