<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <AbilityDef Class="lotr.BeyonderAbilityDef" Name="Cast_BlazingSword" Abstract="True">
        
        <abilityClass>lotr.Ability_SpendSpirituality</abilityClass>
        
        <defName>Cast_BlazingSword</defName>
        <label>Blazing sword</label>
        <description>Concentrates spiritual energy, materializing a legendary fiery sword in the caster's hands. If another weapon was wielded, it is automatically stored in the caster's inventory.</description>
        <iconPath>UI/Icons/Abilities/Hunter/Cast_BlazingSword</iconPath> 
        
        <aiCanUse>false</aiCanUse> <!-- TODO? -->
        <ai_IsOffensive>true</ai_IsOffensive>
        <ai_IsIncendiary>true</ai_IsIncendiary>
        <targetRequired>false</targetRequired>
        <hostile>false</hostile>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>

        <cooldownTicksRange>3600</cooldownTicksRange>
        <spiritualityCost>50.0</spiritualityCost>

        <verbProperties>

            <verbClass>Verb_CastAbility</verbClass>
            <warmupTime>2.0</warmupTime>
            <range>0</range>
            <requireLineOfSight>false</requireLineOfSight>
            <ai_ProjectileLaunchingIgnoresMeleeThreats>true</ai_ProjectileLaunchingIgnoresMeleeThreats>

            <targetParams>
                <canTargetSelf>true</canTargetSelf>
            </targetParams>

        </verbProperties>
    </AbilityDef>

