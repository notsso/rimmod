<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="BaseBullet">

        <defName>Proj_Fireball</defName>
        <label>огненный шар</label>
        <thingClass>Projectile_Explosive</thingClass>

        <graphicData>

            <texPath>Projectiles/Ability_projectile</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>TransparentPostLight</shaderType>
            <color>(255, 120, 0)</color>

        </graphicData>

        <projectile>

            <speed>50</speed>
            <damageDef>Flame</damageDef>
            <damageAmountBase>10</damageAmountBase>
            <explosionRadius>1.0</explosionRadius>
            <ai_IsIncendiary>true</ai_IsIncendiary>

        </projectile>

    </ThingDef>

    <AbilityDef>
        <abilityClass>lotr.Ability_SpendSpirituality</abilityClass>
        <defName>Cast_Fireball</defName>
        <label>огненный шар</label>
        <description>кусок огня</description>
        <iconPath>UI/Icons/Abilities/Hunter/Fireball2</iconPath>
        <cooldownTicksRange>60</cooldownTicksRange>
        <hostile>true</hostile>

        <comps>
            <li Class="CompProperties_AbilityLaunchProjectile">
                <projectileDef>Proj_Fireball</projectileDef>
            </li>
        </comps>

        <verbProperties>

            <verbClass>Verb_CastAbility</verbClass>
            <range>25</range>
            <warmupTime>1.5</warmupTime>
            <hasStandardCommand>true</hasStandardCommand>

            <targetParams>

                <canTargetLocations>true</canTargetLocations>
                <canTargetPawns>true</canTargetPawns>
                <canTargetBuildings>true</canTargetBuildings>

            </targetParams>

        </verbProperties>

        <comps>

            <li Class="CompProperties_AbilityLaunchProjectile">
                <projectileDef>Proj_Fireball</projectileDef>
            </li>

        </comps>

    </AbilityDef>

</Defs>