<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="BaseBullet">

        <defName>Proj_Fireball</defName>
        <label>огненный шар</label>
        <thingClass>lotr.Projectile_Fireball</thingClass>

        <graphicData>

            <texPath>Projectiles/Fireball_projectile</texPath>
            <graphicClass>Graphic_Single</graphicClass>

        </graphicData>

        <projectile>

            <speed>50</speed>
            <damageDef>Flame</damageDef>
            <damageAmountBase>10</damageAmountBase>
            <explosionRadius>1.0</explosionRadius>
            <ai_IsIncendiary>true</ai_IsIncendiary>

        </projectile>

        <comps>
            <li Class="CompProperties_Glower">
                <glowRadius>4</glowRadius> <!-- Радиус освещения (4 клетки вокруг шара) -->
                <glowColor>(255, 130, 30, 0)</glowColor> <!-- Теплый оранжевый свет -->
            </li>
        </comps>

    </ThingDef>

    <AbilityDef>
    
        <abilityClass>lotr.Ability_SpendSpirituality</abilityClass>
        <defName>Cast_Fireball</defName>
        <label>огненный шар</label>
        <description>кусок огня</description>
        <iconPath>UI/Icons/Abilities/Hunter/Fireball</iconPath>
        <cooldownTicksRange>60</cooldownTicksRange>
        <hostile>true</hostile>

        <modExtensions>
            <li Class="lotr.SpiritualityCostExtension">
                <cost>15.0</cost>
            </li>
        </modExtensions>

        <comps>
            <li Class="CompProperties_AbilityLaunchProjectile">
                <projectileDef>Proj_Fireball</projectileDef>
            </li>
        </comps>

        <verbProperties>

            <verbClass>lotr.Verb_CastAbility_Custom</verbClass>
            <range>25</range>
            <warmupTime>1.5</warmupTime>
            <hasStandardCommand>true</hasStandardCommand>

            <targetParams>

                <canTargetLocations>true</canTargetLocations>
                <canTargetPawns>true</canTargetPawns>
                <canTargetBuildings>true</canTargetBuildings>

            </targetParams>

        </verbProperties>

    </AbilityDef>

</Defs>