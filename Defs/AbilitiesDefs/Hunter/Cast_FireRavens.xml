<Defs>

    <AbilityDef Name="Cast_FireRavens">

        <abilityClass>lotr.Ability_SpendSpirituality</abilityClass>
        <defName>Cast_FireRavens</defName>
        <label>огненные вороны</label>
        <description>Создает трех мистических ворон из багрового пламени вокруг заклинателя. Вороны обладают собственным разумом, автоматически набрасываются на ближайших врагов и взрываются при гибели.</description>
        <iconPath>UI/Icons/Abilities/Hunter/Cast_FireRavens</iconPath>
        <cooldownTicksRange>1800</cooldownTicksRange>
        <targetRequired>False</targetRequired>
        <aiCanUse>true</aiCanUse>
        <hostile>false</hostile>

        <modExtensions>
            <li Class="lotr.SpiritualityCostExtension">
                <cost>50.0</cost>
            </li>
        </modExtensions>

        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <warmupTime>0.5</warmupTime>
            <range>0</range>
            <targetParams>
                <canTargetSelf>true</canTargetSelf>
            </targetParams>
        </verbProperties>

    </AbilityDef>

