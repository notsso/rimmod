<Defs>

    <AbilityDef Class="lotr.BeyonderAbilityDef" Name="Cast_FireRavens" Abstract="True">

        <abilityClass>lotr.Ability_SpendSpirituality</abilityClass>
        
        <defName>Cast_FireRavens</defName>
        <label>Fire ravens</label>
        <description>Creates a mystical crow of flame around the caster, capable of attacking nearby enemies.</description>
