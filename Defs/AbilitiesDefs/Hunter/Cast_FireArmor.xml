        <aiCanUse>false</aiCanUse> <!-- TODO? -->
        <ai_IsOffensive>false</ai_IsOffensive>
        <ai_IsIncendiary>false</ai_IsIncendiary>
        <targetRequired>true</targetRequired>
        <hostile>false</hostile>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>

        <cooldownTicksRange>7200</cooldownTicksRange>
        <spiritualityCost>100.0</spiritualityCost>

        <verbProperties>
        
            <verbClass>Verb_CastAbility</verbClass>
            <warmupTime>6.0</warmupTime>
            <range>0</range>
            <requireLineOfSight>true</requireLineOfSight>
            <ai_ProjectileLaunchingIgnoresMeleeThreats>false</ai_ProjectileLaunchingIgnoresMeleeThreats>

            <targetParams>
                <canTargetSelf>true</canTargetSelf>
            </targetParams>

        </verbProperties>
        
    </AbilityDef>

