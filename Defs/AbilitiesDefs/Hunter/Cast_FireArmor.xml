    <AbilityDef Class="lotr.BeyonderAbilityDef" Name="Cast_FireArmor" Abstract="True">

        <abilityClass>lotr.Ability_SpendSpirituality</abilityClass>
        
        <defName>Cast_FireArmor</defName>
        <label>Fire armor</label>
        <description>Creates a dense fiery cover around the body that melts projectiles, warms in any frost and burns toxic gases as they approach.</description>
