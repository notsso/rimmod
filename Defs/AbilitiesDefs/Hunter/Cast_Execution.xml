<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <AbilityDef Class="lotr.BeyonderAbilityDef" Name="Cast_Execution" Abstract="True">
    
        <abilityClass>lotr.Ability_SpendSpirituality</abilityClass>
        
        <defName>Cast_Execution</defName>
        <label>Execution</label>
        <description>Create and launch a super-powerful, highly compressed projectile of white flame. The projectile is imbued with the essence of death, penetrates armor, and is capable of injuring demigods.</description>
        <iconPath>UI/Icons/Abilities/Hunter/Cast_Execution</iconPath>

        <aiCanUse>true</aiCanUse>
        <ai_IsOffensive>true</ai_IsOffensive>
        <ai_IsIncendiary>false</ai_IsIncendiary>
        <ai_SearchAOEForTargets>true</ai_SearchAOEForTargets>
        <targetRequired>true</targetRequired>
        <hostile>true</hostile>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>

        <cooldownTicksRange>6000</cooldownTicksRange>
        <spiritualityCost>300.0</spiritualityCost>

        <verbProperties>

            <verbClass>lotr.Verb_ExplosionZone</verbClass>
            <range>50</range>
            <warmupTime>4.0</warmupTime>
            <requireLineOfSight>true</requireLineOfSight>
            <ai_ProjectileLaunchingIgnoresMeleeThreats>false</ai_ProjectileLaunchingIgnoresMeleeThreats>

            <targetParams>
                <canTargetLocations>true</canTargetLocations>
                <canTargetPawns>true</canTargetPawns>
                <canTargetBuildings>true</canTargetBuildings>
            </targetParams>

        </verbProperties>

    </AbilityDef>

    <!-- Уровень 5 -->
    <AbilityDef Class="lotr.BeyonderAbilityDef" ParentName="Cast_Execution">
        <defName>Cast_Execution_5S</defName>
        <cooldownTicksRange>6000</cooldownTicksRange>
        <spiritualityCost>300.0</spiritualityCost>

        <comps>
            <li Class="CompProperties_AbilityLaunchProjectile">
                <projectileDef>Proj_Execution_5S</projectileDef>
            </li>
        </comps>
        <verbProperties>
            <range>50</range>
            <warmupTime>3.0</warmupTime>
        </verbProperties>
    </AbilityDef>

    <!-- Уровень 4 -->
    <AbilityDef Class="lotr.BeyonderAbilityDef" ParentName="Cast_Execution">
