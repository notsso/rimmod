    <ThingDef>
        <defName>MeleeWeapon_GiantSunsetSword</defName>
        <label>giant Sunset Sword</label>
        <description>A colossal blade of solidified dawnlight, wielded only by Dawn Giants.</description>
        <category>Item</category>

        <thingClass>lotr.SummonedFireWeapon</thingClass>

        <equipmentType>Primary</equipmentType>
        <selectable>true</selectable>
        <drawerType>MapMeshOnly</drawerType>
        <drawGUIOverlay>true</drawGUIOverlay>
        <altitudeLayer>Item</altitudeLayer>
        <alwaysHaulable>true</alwaysHaulable>
        <tickerType>Normal</tickerType>
        <techLevel>Medieval</techLevel>
        
        <smeltable>false</smeltable>
        <tradeability>None</tradeability>
        <destroyOnDrop>true</destroyOnDrop>

        <equippedAngleOffset>-25</equippedAngleOffset>

        <graphicData>
            <texPath>Things/Item/Equipment/WeaponGiant/SunsetSword</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>TransparentPostLight</shaderType>
            <drawSize>3.0</drawSize>
        </graphicData>

        <statBases>
            <MaxHitPoints>100</MaxHitPoints>
            <Mass>1.5</Mass>
            <MarketValue>500</MarketValue>
            <Flammability>0.0</Flammability>
            <DeteriorationRate>0</DeteriorationRate>
        </statBases>

        <comps>
            <li>
                <compClass>CompEquippable</compClass>
            </li>

            <li>
