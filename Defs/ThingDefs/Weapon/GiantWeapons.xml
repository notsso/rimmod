                <power>50</power>
                <armorPenetration>1.5</armorPenetration>
                <cooldownTime>1.0</cooldownTime>
            </li>
            <li>
                <label>edge</label>
                <capacities><li>Cut</li></capacities>
                <power>50</power>
                <armorPenetration>1.5</armorPenetration>
                <cooldownTime>1.0</cooldownTime>
            </li>
        </tools>

        <weaponClasses>
            <li>Melee</li>
        </weaponClasses>

        <weaponTags>
            <li>GiantWeapon</li>
            <li>GiantSunsetSword</li>
        </weaponTags>
    </ThingDef>

