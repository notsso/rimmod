<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="PotionBase">
        <thingClass>ThingWithComps</thingClass>
        <defName>Bard9_Potion</defName>
        <label>barde's potion</label>
        <description>A constantly churning crimson liquid.
        By drinking it, the pawn will awaken the power of the Bard within itself.</description>
        <descriptionHyperlinks>
            <HediffDef>Bard9_Hediff</HediffDef>
        </descriptionHyperlinks>
        <graphicData>
            <texPath>Potions/Bard/Bard9_Potion</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>

        <ingestible>
            <outcomeDoers>
                <li Class="lotr.IngestionOutcomeDoer_GiveHediffRange">
                    <hediffDef>lotr_SanityLoss</hediffDef>
                    <severityRange>0.15~0.75</severityRange>
                </li>

                <li Class="lotr.IngestionOutcomeDoer_SequenceAdvance">
                    <hediffToGive>Bard9_Hediff</hediffToGive>
                    <severity>0.01</severity>
                </li>
            </outcomeDoers>
        </ingestible>
    </ThingDef>

