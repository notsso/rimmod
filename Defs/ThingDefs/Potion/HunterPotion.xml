<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="PotionBase">

        <thingClass>ThingWithComps</thingClass>
        <defName>Hunter9_Potion</defName>
        <label>hunter's potion</label>
        <description>A deep red liquid, bubbling as if blood is staining the entire glass. It has a pungent odor of blood that would fill their nostrils.
        By drinking it, the pawn will awaken the power of the Hunter within itself.</description>
        <descriptionHyperlinks>
            <HediffDef>Hunter9_Hediff</HediffDef>
        </descriptionHyperlinks>
        <graphicData>
            <texPath>Potions/Hunter/Hunter9_Potion</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>

        <ingestible>
            <outcomeDoers>
                <li Class="lotr.IngestionOutcomeDoer_GiveHediffRange">
                    <hediffDef>lotr_SanityLoss</hediffDef>
                    <severityRange>0.15~0.75</severityRange> 
                </li>

                <li Class="lotr.IngestionOutcomeDoer_SequenceAdvance">
                    <hediffToGive>Hunter9_Hediff</hediffToGive>
                    <severity>0.01</severity>
                </li>
            </outcomeDoers>
        </ingestible>

    </ThingDef>

