<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="PotionBase">

        <thingClass>ThingWithComps</thingClass>
        <defName>Hunter9_Potion</defName>
        <label>hunter's potion</label>
        <description>Флакон с бурлящей красной жидкостью. Выпив его, пешка пробудит в себе силу Охотника.</description>
        <descriptionHyperlinks>
            <HediffDef>Hunter9_Hediff</HediffDef>
        </descriptionHyperlinks>
        <graphicData>
            <texPath>Potions/Hunter9_Potion</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>

        <ingestible>
            <outcomeDoers>
                <li Class="lotr.IngestionOutcomeDoer_GiveHediffRange">
                    <hediffDef>lotr_SanityLoss</hediffDef>
                    <severityRange>0.15~0.75</severityRange> 
                </li>

                <li Class="IngestionOutcomeDoer_GiveHediff">
                    <hediffDef>Hunter9_Hediff</hediffDef>
                    <severity>0.01</severity>
                </li>
            </outcomeDoers>
        </ingestible>

    </ThingDef>

    <ThingDef ParentName="PotionBase">

        <thingClass>ThingWithComps</thingClass>
        <defName>Hunter8_Potion</defName>
        <label>provoker's potion</label>
        <description>Флакон с искрящейся алой жидкостью. Выпив его, пешка откроет в себе коварную силу Провокатора</description>
        <descriptionHyperlinks>
            <HediffDef>Hunter8_Hediff</HediffDef>
        </descriptionHyperlinks>
        <graphicData>
            <texPath>Potions/Hunter9_Potion</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>

        <ingestible>
            <outcomeDoers>
                <li Class="lotr.IngestionOutcomeDoer_GiveHediffRange">
                    <hediffDef>lotr_SanityLoss</hediffDef>
                    <severityRange>0.15~0.75</severityRange> 
                </li>

                <li Class="lotr.IngestionOutcomeDoer_SequenceAdvance">
                    <hediffToRemove>Hunter9_Hediff</hediffToRemove>
                    <hediffToGive>Hunter8_Hediff</hediffToGive>
                    <severity>0.01</severity>
                </li>
            </outcomeDoers>
        </ingestible>

    </ThingDef>

    <ThingDef ParentName="PotionBase">

        <thingClass>ThingWithComps</thingClass>
        <defName>Hunter7_Potion</defName>
        <label>pyromaniac's potion</label>
        <description>Флакон с бушующим алым пламенем, запертым внутри стекла. Выпив его, пешка подчинит себе ярость огня и станет Пироманьяком</description>
        <descriptionHyperlinks>
            <HediffDef>Hunter7_Hediff</HediffDef>
        </descriptionHyperlinks>
        <graphicData>
            <texPath>Potions/Hunter9_Potion</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>

        <ingestible>
            <outcomeDoers>
                <li Class="lotr.IngestionOutcomeDoer_GiveHediffRange">
                    <hediffDef>lotr_SanityLoss</hediffDef>
                    <severityRange>0.15~0.75</severityRange> 
                </li>

                <li Class="lotr.IngestionOutcomeDoer_SequenceAdvance">
                    <hediffToRemove>Hunter8_Hediff</hediffToRemove>
                    <hediffToGive>Hunter7_Hediff</hediffToGive>
                    <severity>0.01</severity>
                </li>
            </outcomeDoers>
        </ingestible>

    </ThingDef>

</Defs>