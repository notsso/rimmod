<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="PotionBase">

        <thingClass>ThingWithComps</thingClass>
        <defName>Hunter9_Potion</defName>
        <label>hunter's potion</label>
        <description>Жидкость насыщенного красного цвета, бурлящая, словно кровь окрашивает весь флакон.
        У неё резкий запах крови, который заполнил бы их ноздри.
        Выпив его, пешка пробудит в себе силу Охотника.</description>
        <descriptionHyperlinks>
            <HediffDef>Hunter9_Hediff</HediffDef>
        </descriptionHyperlinks>
        <graphicData>
            <texPath>Potions/Hunter9_Potion</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>

        <ingestible>
            <outcomeDoers>
                <li Class="lotr.IngestionOutcomeDoer_GiveHediffRange">
                    <hediffDef>lotr_SanityLoss</hediffDef>
                    <severityRange>0.15~0.75</severityRange> 
                </li>

                <li Class="lotr.IngestionOutcomeDoer_SequenceAdvance">
                    <hediffToGive>Hunter9_Hediff</hediffToGive>
                    <severity>0.01</severity>
                </li>
            </outcomeDoers>
        </ingestible>

    </ThingDef>

