<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="PotionBase">

        <thingClass>ThingWithComps</thingClass>
        <defName>Assassin9_Potion</defName>
        <label>Assassin's potion</label>
        <description>Dull, inconspicuous liquid that inexplicably induces thirst.
        By drinking it, the pawn will awaken the power of the Hunter within itself.</description>
        <descriptionHyperlinks>
            <HediffDef>Assassin9_Hediff</HediffDef>
        </descriptionHyperlinks>
        <graphicData>
            <texPath>Potions/Assassin/Assassin9_Potion</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>

        <ingestible>
            <outcomeDoers>
                <li Class="lotr.IngestionOutcomeDoer_GiveHediffRange">
                    <hediffDef>lotr_SanityLoss</hediffDef>
                    <severityRange>0.15~0.75</severityRange> 
                </li>

                <li Class="lotr.IngestionOutcomeDoer_SequenceAdvance">
                    <hediffToGive>Assassin9_Hediff</hediffToGive>
                    <severity>0.01</severity>
                </li>
            </outcomeDoers>
        </ingestible>

    </ThingDef>

