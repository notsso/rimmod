<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="PotionBase">

        <thingClass>ThingWithComps</thingClass>
        <defName>Warrior9_Potion</defName>
        <label>Warrior's potion</label>
        <description>Кроваво-красная жидкость с сильным рыбным запахом.
        Выпив его, пешка пробудит в себе силу Воина.</description>
        <descriptionHyperlinks>
            <HediffDef>Warrior9_Hediff</HediffDef>
        </descriptionHyperlinks>
        <graphicData>
            <texPath>Potions/Warrior/Warrior9_Potion</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>

        <ingestible>
            <outcomeDoers>
                <li Class="lotr.IngestionOutcomeDoer_GiveHediffRange">
                    <hediffDef>lotr_SanityLoss</hediffDef>
                    <severityRange>0.15~0.75</severityRange> 
                </li>

                <li Class="lotr.IngestionOutcomeDoer_SequenceAdvance">
                    <hediffToGive>Warrior9_Hediff</hediffToGive>
                    <severity>0.01</severity>
                </li>
            </outcomeDoers>
        </ingestible>

    </ThingDef>

