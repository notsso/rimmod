<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    
    <ThingDef ParentName="PlantBase">

        <thingClass>lotr.Plant_CorpseLily</thingClass>
        <defName>lotr_CorpseLily</defName>
        <label>Трупные лилии</label>
        <description>A sinister, crimson flower that feeds on the residual life energy of fresh corpses. Its petals glow slightly with a warm, fleshy heat.</description>
        
        <statBases>
            <MaxHitPoints>85</MaxHitPoints>
            <Nutrition>0.05</Nutrition>
            <BeautyOutdoors>20</BeautyOutdoors>
            <DeteriorationRate>-10</DeteriorationRate>
        </statBases>

        <graphicData>
            <texPath>Things/Plant/DayLily</texPath>
            <graphicClass>Graphic_Random</graphicClass>
        </graphicData>

        <selectable>true</selectable>
        <neverMultiSelect>false</neverMultiSelect>
        <pathCost>14</pathCost>

        <ingestible />
        
        <plant>
            <harvestedThingDef>lotr_CorpseLilyRootstock</harvestedThingDef>
            <harvestYield>1</harvestYield>
            <harvestAfterGrowth>0.30</harvestAfterGrowth>
            <harvestTag>Standard</harvestTag>
            <harvestWork>400</harvestWork>
            <dieIfLeafless>false</dieIfLeafless>
            <wildOrder>2</wildOrder>
            <purpose>Misc</purpose>
            <growDays>1</growDays>
            <growMinGlow>0</growMinGlow>
            <minGrowthTemperature>-50</minGrowthTemperature>
            <maxGrowthTemperature>50</maxGrowthTemperature>
            <visualSizeRange>0.3~1.0</visualSizeRange>
            <topWindExposure>0.1</topWindExposure>
            <growMinGlow>0.3</growMinGlow>
            <allowAutoCut>false</allowAutoCut>
        </plant>

        <comps>
            <li Class="CompProperties_Glower">
                <glowRadius>3</glowRadius>
                <glowColor>(200,30,30,0)</glowColor>
            </li>
        </comps>
    
    </ThingDef>
    
</Defs>
