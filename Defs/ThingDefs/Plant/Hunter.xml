<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    
    <ThingDef ParentName="PlantBase">

        <thingClass>lotr.Plant_CorpseLily</thingClass>
        <defName>lotr_CorpseLily</defName>
        <label>Трупные лилии</label>
        <description>A sinister, crimson flower that feeds on the residual life energy of fresh corpses. Its petals glow slightly with a warm, fleshy heat.</description>
        
        <statBases>
            <MaxHitPoints>85</MaxHitPoints>
            <Nutrition>0.05</Nutrition>
            <BeautyOutdoors>20</BeautyOutdoors>
            <DeteriorationRate>-10</DeteriorationRate>
        </statBases>

        <graphicData>
            <texPath>Things/Plant/DayLily</texPath>
            <graphicClass>Graphic_Random</graphicClass>
        </graphicData>

        <selectable>true</selectable>
        <neverMultiSelect>false</neverMultiSelect>
        <pathCost>14</pathCost>

        <ingestible />
        
        <plant>
            <harvestedThingDef>lotr_CorpseLilyRootstock</harvestedThingDef>
            <harvestYield>1</harvestYield>
            <harvestAfterGrowth>0.30</harvestAfterGrowth>
            <harvestTag>Standard</harvestTag>
            <harvestWork>400</harvestWork>
            <dieIfLeafless>false</dieIfLeafless>
            <wildOrder>2</wildOrder>
            <purpose>Misc</purpose>
            <growDays>1</growDays>
            <growMinGlow>0</growMinGlow>
            <minGrowthTemperature>-50</minGrowthTemperature>
            <maxGrowthTemperature>50</maxGrowthTemperature>
            <visualSizeRange>0.3~1.0</visualSizeRange>
            <topWindExposure>0.1</topWindExposure>
            <growMinGlow>0.3</growMinGlow>
            <allowAutoCut>false</allowAutoCut>
        </plant>

        <comps>
            <li Class="CompProperties_Glower">
                <glowRadius>3</glowRadius>
                <glowColor>(200,30,30,0)</glowColor>
            </li>
        </comps>
    
    </ThingDef>

    <ThingDef ParentName="DeciduousTreeBase">
        <defName>Plant_BloodRedChestnut</defName>
        <label>Blood Red Chestnut</label>
        <description>A rare hardwood tree with deep crimson bark. When cut, it releases a fragment of beyonder essence.</description>

        <thingClass>lotr.Plant_BloodRedChestnut</thingClass>

        <graphicData>
            <texPath>Things/Plant/TreeOak</texPath>
            <graphicClass>Graphic_Random</graphicClass>
            <shadowData>
                <volume>(0.2, 0.35, 0.13)</volume>
                <offset>(-0.03,0,-0.44)</offset>
            </shadowData>
        </graphicData>

        <statBases>
            <Beauty>2</Beauty>
            <BeautyOutdoors>2</BeautyOutdoors>
        </statBases>

        <plant>
            <growDays>30</growDays>
            <harvestWork>1400</harvestWork>
            <harvestYield>46</harvestYield>
            <harvestTag>Wood</harvestTag>
            <harvestedThingDef>WoodLog</harvestedThingDef>

            <leaflessGraphicPath>Things/Plant/TreeOak_Leafless</leaflessGraphicPath>
            <immatureGraphicPath>Things/Plant/TreeOak_Immature</immatureGraphicPath>
            <leaflessImmatureGraphicPath>Things/Plant/TreeOak_LeaflessImmature</leaflessImmatureGraphicPath>
            <leaflessSnowOverlayGraphicPath>Things/Plant/TreeOak_LeaflessSnowy</leaflessSnowOverlayGraphicPath>
            <immatureSnowOverlayGraphicPath>Things/Plant/TreeOak_LeaflessSnowyImmature</immatureSnowOverlayGraphicPath>
        </plant>
    </ThingDef>
    
</Defs>