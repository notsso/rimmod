<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="AnimalThingBase">

        <defName>lotr_ForestHunterRace</defName>
        <label>Лесной охотник</label>
        <description>Антропоморфное существо, покрытое жесткой, маскирующей шерстью древесных оттенков. У него длинные, неестественно сильные конечности и острые клыки.</description>
        
        <statBases>
            <MoveSpeed>15.0</MoveSpeed>
            <MarketValue>2500</MarketValue>
            <ComfyTemperatureMin>-150</ComfyTemperatureMin>
            <ComfyTemperatureMax>150</ComfyTemperatureMax>
            <ArmorRating_Blunt>0.90</ArmorRating_Blunt>
            <ArmorRating_Sharp>0.90</ArmorRating_Sharp>
            <ArmorRating_Heat>0.90</ArmorRating_Heat>
            <Wildness>1</Wildness> 

            <MeatAmount>0</MeatAmount>
            <LeatherAmount>0</LeatherAmount>

            <Flammability>0</Flammability>
            <ToxicResistance>1</ToxicResistance>
            <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
            <IncomingDamageFactor>0.50</IncomingDamageFactor> 
            <InjuryHealingFactor>3.0</InjuryHealingFactor>
            <MeleeHitChance>20</MeleeHitChance>
            <MeleeDodgeChance>20</MeleeDodgeChance>

            <SpiritualityOffset>10</SpiritualityOffset>
        </statBases>

        <race>
            <thinkTreeMain>Animal</thinkTreeMain> <!-- lotr_DemonicWolfTree -->
            <body>Monkey</body>
            <baseHungerRate>0.01</baseHungerRate>
            <baseBodySize>1.0</baseBodySize>
            <baseHealthScale>5.0</baseHealthScale>

            <foodType>CarnivoreAnimal, OvivoreAnimal</foodType>
            <predator>true</predator>
            <trainability>None</trainability>
            <lifeExpectancy>500</lifeExpectancy>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <manhunterOnTameFailChance>1</manhunterOnTameFailChance>
            
            <herdAnimal>false</herdAnimal>

            <litterSizeCurve>
                <points>
                <li>(0.5, 0)</li>
                <li>(1, 1)</li>
                <li>(2, 1.7)</li>
                <li>(2.5, 0.7)</li>
                <li>(3, 0)</li>
                </points>
            </litterSizeCurve>

            <lifeStageAges>
                <li>
                    <def>AnimalBaby</def>
                    <minAge>0</minAge>
                </li>
                <li>
                    <def>AnimalJuvenile</def>
                    <minAge>0.1</minAge>
                </li>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0.2</minAge>
                    <soundWounded>Pawn_Monkey_Wounded</soundWounded>
                    <soundDeath>Pawn_Monkey_Death</soundDeath>
                    <soundCall>Pawn_Monkey_Call</soundCall>
                    <soundAngry>Pawn_Monkey_Angry</soundAngry>
                </li>
            </lifeStageAges>

            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
            <soundEating>Herbivore_Eat</soundEating>

            <headPosPerRotation>
                <li>(0.0, 0, 0.09)</li>
                <li>(0.21, 0, -0.04)</li>
                <li>(0.0, 0, -0.18)</li>
                <li>(-0.21, 0, -0.04)</li>
            </headPosPerRotation>
        </race>

        <tools>
            <li>
                <label>left fist</label>
                <labelNoLocation>fist</labelNoLocation>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>20</power>
                <cooldownTime>0.5</cooldownTime>
                <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
            </li>
            <li>
                <label>right fist</label>
                <labelNoLocation>fist</labelNoLocation>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>20</power>
                <cooldownTime>0.5</cooldownTime>
                <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
            </li>
            <li>
                <capacities>
                    <li>Bite</li>
                </capacities>
                <power>30</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
                <chanceFactor>0.7</chanceFactor>
            </li>
            <li>
                <label>head</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>20</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
            </li>
        </tools>

        <butcherProducts>
            <lotr_ForestHunterTongue>1</lotr_ForestHunterTongue>
            <lotr_MysticalComponents>2</lotr_MysticalComponents>
        </butcherProducts>

    </ThingDef>

    <PawnKindDef ParentName="AnimalKindBase">
    
        <defName>lotr_ForestHunter</defName>
        <label>Forest Hunter</label>
        <race>lotr_ForestHunterRace</race>
        <combatPower>1000</combatPower>
        <ecoSystemWeight>1.0</ecoSystemWeight>
        
        <abilities>
            <li>Cast_Vulnerability_5S</li>
            <li>Cast_Confusion_6S</li>
        </abilities>

        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Monkey/Monkey</texPath>
                    <drawSize>1.50</drawSize>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Monkey/Monkey</texPath>
                    <drawSize>2.50</drawSize>
                    <shadowData>
                        <volume>(0.2, 0.2, 0.2)</volume>
                        <offset>(0,0,-0.2)</offset>
                    </shadowData>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Monkey/Monkey</texPath>
                    <drawSize>3.0</drawSize>
                    <shadowData>
                        <volume>(0.3, 0.3, 0.3)</volume>
                        <offset>(0,0,-0.2)</offset>
                    </shadowData>
                </bodyGraphicData>
            </li>
        </lifeStages>

    </PawnKindDef>

</Defs>