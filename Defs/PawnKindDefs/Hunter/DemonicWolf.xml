<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="AnimalThingBase">

        <defName>lotr_DemonicWolfRace</defName>
        <label>Серый демонический волк</label>
        <description>Массивный хищник, который гораздо крупнее обычного лесного волка. Его шерсть имеет грязно-серый, пепельный оттенок, способный сливаться с тенями. Обычные люди или слабые Потусторонние сходят с ума или цепенеют от одного только рыка этого зверя.</description>
        
        <statBases>
            <MoveSpeed>10.0</MoveSpeed>
            <MarketValue>2500</MarketValue>
            <ComfyTemperatureMin>-150</ComfyTemperatureMin>
            <ComfyTemperatureMax>150</ComfyTemperatureMax>
            <ArmorRating_Blunt>0.90</ArmorRating_Blunt>
            <ArmorRating_Sharp>0.90</ArmorRating_Sharp>
            <ArmorRating_Heat>0.90</ArmorRating_Heat>
            <Wildness>1</Wildness> 

            <MeatAmount>0</MeatAmount>
            <LeatherAmount>0</LeatherAmount>

            <Flammability>0</Flammability>
            <ToxicResistance>1</ToxicResistance>
            <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
            <IncomingDamageFactor>0.50</IncomingDamageFactor> 
            <InjuryHealingFactor>3.0</InjuryHealingFactor>
            <MeleeHitChance>20</MeleeHitChance>
            <MeleeDodgeChance>20</MeleeDodgeChance>

            <SpiritualityOffset>10</SpiritualityOffset>
        </statBases>

        <race>
            <thinkTreeMain>Animal</thinkTreeMain>
            <body>QuadrupedAnimalWithPawsAndTail</body>
            <baseHungerRate>0.01</baseHungerRate>
            <baseBodySize>4.0</baseBodySize>
            <baseHealthScale>10.0</baseHealthScale>

            <foodType>CarnivoreAnimal, OvivoreAnimal</foodType>
            <predator>true</predator>
            <trainability>None</trainability>
            <lifeExpectancy>500</lifeExpectancy>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <manhunterOnTameFailChance>1</manhunterOnTameFailChance>
            
            <herdAnimal>false</herdAnimal>

            <litterSizeCurve>
                <points>
                <li>(0.5, 0)</li>
                <li>(1, 1)</li>
                <li>(2, 1.7)</li>
                <li>(2.5, 0.7)</li>
                <li>(3, 0)</li>
                </points>
            </litterSizeCurve>

            <lifeStageAges>
                <li>
                    <def>AnimalBaby</def>
                    <minAge>0</minAge>
                </li>
                <li>
                    <def>AnimalJuvenile</def>
                    <minAge>0.15</minAge>
                </li>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0.3</minAge>
                    <soundWounded>Pawn_Dog_Injured</soundWounded>
                    <soundDeath>Pawn_Dog_Death</soundDeath>
                    <soundCall>Pawn_Dog_Call</soundCall>
                    <soundAngry>Pawn_Dog_Angry</soundAngry>
                </li>
            </lifeStageAges>

            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
            <soundEating>PredatorLarge_Eat</soundEating>

            <headPosPerRotation>
                <li>(0.0, 0, 0.3)</li>
                <li>(0.32, 0, 0.08)</li>
                <li>(0.0, 0, -0.21)</li>
                <li>(-0.32, 0, 0.08)</li>
            </headPosPerRotation>
        </race>

        <tools>
            <li>
                <label>left claw</label>
                <labelNoLocation>claw</labelNoLocation>
                <capacities>
                    <li>Scratch</li>
                </capacities>
                <power>30</power>
                <cooldownTime>0.5</cooldownTime>
                <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
                <surpriseAttack>
                    <extraMeleeDamages>
                        <li>
                            <def>Stun</def>
                            <amount>30</amount>
                        </li>
                    </extraMeleeDamages>
                </surpriseAttack>
            </li>
            <li>
                <label>right claw</label>
                <labelNoLocation>claw</labelNoLocation>
                <capacities>
                    <li>Scratch</li>
                </capacities>
                <power>30</power>
                <cooldownTime>0.5</cooldownTime>
                <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
                <surpriseAttack>
                    <extraMeleeDamages>
                        <li>
                            <def>Stun</def>
                            <amount>30</amount>
                        </li>
                    </extraMeleeDamages>
                </surpriseAttack>
            </li>
            <li>
                <capacities>
                    <li>Bite</li>
                </capacities>
                <power>40</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
                <chanceFactor>0.5</chanceFactor>
                <surpriseAttack>
                    <extraMeleeDamages>
                        <li>
                            <def>Stun</def>
                            <amount>30</amount>
                        </li>
                    </extraMeleeDamages>
                </surpriseAttack>
            </li>
            <li>
                <label>head</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>30</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.3</chanceFactor>
            </li>
        </tools>

        <butcherProducts>
            <lotr_DemonicWolfClaws>1</lotr_DemonicWolfClaws>
            <lotr_MysticalComponents>2</lotr_MysticalComponents>
        </butcherProducts>

    </ThingDef>

    <PawnKindDef ParentName="AnimalKindBase">
    
        <defName>lotr_DemonicWolf</defName>
        <label>Demonic Wolf</label>
        <race>lotr_DemonicWolfRace</race>
        <combatPower>1000</combatPower>
        <ecoSystemWeight>1.0</ecoSystemWeight>
        
        <abilities>
            <li>Cast_Execution_5S</li>
            <li>Cast_BlazingSpear_6S</li>
            <li>Cast_Incite_6S</li>
        </abilities>

        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Wolf_Timber/Wolf_Timber</texPath>
                    <drawSize>2.00</drawSize>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Wolf_Timber/Wolf_Timber</texPath>
                    <drawSize>4.0</drawSize>
                    <shadowData>
                        <volume>(0.25, 0.3, 0.25)</volume>
                        <offset>(0,0,-0.15)</offset>
                    </shadowData>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Wolf_Timber/Wolf_Timber</texPath>
                    <drawSize>5.0</drawSize>
                    <shadowData>
                        <volume>(0.3, 0.4, 0.3)</volume>
                        <offset>(0,0,-0.15)</offset>
                    </shadowData>
                </bodyGraphicData>
            </li>
        </lifeStages>

    </PawnKindDef>

</Defs>