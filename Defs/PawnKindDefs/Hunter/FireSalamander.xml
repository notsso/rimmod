<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="AnimalThingBase">
        
        <defName>lotr_FireSalamanderRace</defName>
        <label>Fire salamander</label>
        <description>These large lizards normally feed on plant matter. However, when angered, their tough hide and sharp claws make them quite dangerous.\n\nResting iguanas hold their heads high, giving them an amusing 'proud' look. But they're not proud; they're just trying to see predators so they don't get eaten.</description>
        
        <statBases>
            <MoveSpeed>3.0</MoveSpeed>
            <MarketValue>100</MarketValue>
            <ComfyTemperatureMin>-30</ComfyTemperatureMin>
            <ComfyTemperatureMax>180</ComfyTemperatureMax>
            <ArmorRating_Blunt>0.50</ArmorRating_Blunt>
            <ArmorRating_Sharp>0.50</ArmorRating_Sharp>
            <ArmorRating_Heat>0.80</ArmorRating_Heat>
            <Wildness>1</Wildness>

            <MeatAmount>0</MeatAmount>
            <LeatherAmount>0</LeatherAmount>

            <Flammability>0</Flammability>
            <ToxicEnvironmentResistance>0.95</ToxicEnvironmentResistance>

            <SpiritualityOffset>3</SpiritualityOffset>
        </statBases>

        <race>
            <thinkTreeMain>Animal</thinkTreeMain>
            <body>QuadrupedAnimalWithClawsTailAndJowl</body>
            <baseHungerRate>0.01</baseHungerRate>
            <baseBodySize>1.8</baseBodySize>
            <baseHealthScale>4.0</baseHealthScale>
            
            <foodType>OmnivoreRoughAnimal</foodType>
            <predator>true</predator>
            <trainability>None</trainability>
            <lifeExpectancy>25</lifeExpectancy>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <manhunterOnTameFailChance>1</manhunterOnTameFailChance>

            <soundEating>Reptile_Eat</soundEating>

            <lifeStageAges>
                <li>
                    <def>AnimalBaby</def>
                    <minAge>0</minAge>
                </li>
                <li>
                    <def>AnimalJuvenile</def>
                    <minAge>0.1</minAge>
                </li>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0.2222</minAge>
                    <soundWounded>Pawn_Iguana_Wounded</soundWounded>
                    <soundDeath>Pawn_Iguana_Death</soundDeath>
                    <soundCall>Pawn_Iguana_Call</soundCall>
                    <soundAngry>Pawn_Iguana_Angry</soundAngry>
                </li>
            </lifeStageAges>

            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>

            <headPosPerRotation>
                <li>(-0.01, 0, 0.3)</li>
                <li>(0.35, 0, 0.05)</li>
                <li>(0.0, 0, -0.24)</li>
                <li>(-0.35, 0, 0.05)</li>
            </headPosPerRotation>
        </race>
        
        <tools>
            <li>
                <label>left claw</label>
                <labelNoLocation>claw</labelNoLocation>
                <capacities>
                    <li>Scratch</li>
                </capacities>
                <power>16</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>FrontLeftClaws</linkedBodyPartsGroup>
            </li>
            <li>
                <label>right claw</label>
                <labelNoLocation>claw</labelNoLocation>
                <capacities>
                    <li>Scratch</li>
                </capacities>
                <power>16</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>FrontRightClaws</linkedBodyPartsGroup>
            </li>
            <li>
                <capacities>
                <li>Bite</li>
                </capacities>
                <power>20</power>
                <cooldownTime>1.8</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
                <chanceFactor>0.7</chanceFactor>
            </li>
            <li>
                <label>head</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>10</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
            </li>
        </tools>

        <butcherProducts>
            <lotr_FireSalamanderGland>1</lotr_FireSalamanderGland>
            <lotr_MysticalComponents>1</lotr_MysticalComponents>
        </butcherProducts>

    </ThingDef>
    
    <PawnKindDef ParentName="AnimalKindBase">

        <defName>lotr_FireSalamander</defName>
        <label>Fire salamander</label>
        <race>lotr_FireSalamanderRace</race>
        <combatPower>300</combatPower>
        <ecoSystemWeight>0.80</ecoSystemWeight>

        <abilities>
            <li>Cast_Fireball_7S</li>
        </abilities>

        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/FireSalamander/FireSalamander</texPath>
                    <drawSize>1</drawSize>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/FireSalamander/FireSalamander</texPath>
                    <drawSize>1.25</drawSize>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/FireSalamander/FireSalamander</texPath>
                    <drawSize>1.5</drawSize>
                    <shadowData>
                        <volume>(0.25, 0.3, 0.25)</volume>
                        <offset>(0,0,0)</offset>
                    </shadowData>
                </bodyGraphicData>
            </li>
        </lifeStages>

    </PawnKindDef>

</Defs>