<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="AnimalThingBase">

        <defName>lotr_CuspidsParrotRace</defName>
        <label>Острозубый попугай</label>
        <description>Эти попугаи обладают зачатками разума и известны тем, что имитируют голоса людей, выкрикивая невероятно обидные, злые и провокационные фразы, чтобы выманить хищников на ловушки.</description>
        
        <statBases>
            <MoveSpeed>5</MoveSpeed>
            <MarketValue>500</MarketValue>
            <ComfyTemperatureMin>-30</ComfyTemperatureMin>
            <ComfyTemperatureMax>60</ComfyTemperatureMax>
            <ArmorRating_Blunt>0.30</ArmorRating_Blunt>
            <ArmorRating_Sharp>0.30</ArmorRating_Sharp>
            <ArmorRating_Heat>0.30</ArmorRating_Heat>
            <Wildness>1</Wildness>

            <MeatAmount>0</MeatAmount>
            <LeatherAmount>0</LeatherAmount>

            <MaxFlightTime>5</MaxFlightTime>
            <FlightCooldown>5</FlightCooldown>

            <SpiritualityOffset>0.5</SpiritualityOffset>
        </statBases>

        <race>
            <thinkTreeMain>Animal</thinkTreeMain>
            <body>Bird</body>
            <baseHungerRate>0.01</baseHungerRate>
            <baseBodySize>0.3</baseBodySize>
            <baseHealthScale>3.0</baseHealthScale>

            <foodType>OmnivoreRoughAnimal</foodType>
            <predator>true</predator>
            <trainability>None</trainability>
            <lifeExpectancy>10</lifeExpectancy>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <manhunterOnTameFailChance>1</manhunterOnTameFailChance>

            <flightStartChanceOnJobStart>1.0</flightStartChanceOnJobStart>

            <lifeStageAges>
                <li>
                    <def>AnimalBaby</def>
                    <minAge>0</minAge>
                </li>
                <li>
                    <def>AnimalJuvenile</def>
                    <minAge>0.1</minAge>
                </li>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0.2</minAge>
                    <soundWounded>Pawn_Chicken_Wounded</soundWounded>
                    <soundDeath>Pawn_Chicken_Death</soundDeath>
                    <soundCall>Pawn_Chicken_Call</soundCall>
                    <soundAngry>Pawn_Chicken_Angry</soundAngry>
                </li>
            </lifeStageAges>

            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
            <soundEating>Bird_Eat</soundEating>

            <headPosPerRotation>
                <li>(0.0, 0, 0.24)</li>
                <li>(0.25, 0, 0.18)</li>
                <li>(0.0, 0, 0.07)</li>
                <li>(-0.25, 0, 0.18)</li>
            </headPosPerRotation>
        </race>

        <tools>
            <li>
                <label>claws</label>
                <capacities>
                    <li>Scratch</li>
                </capacities>
                <power>6</power>
                <cooldownTime>1.0</cooldownTime>
                <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
            </li>
            <li>
                <label>beak</label>
                <capacities>
                    <li>Bite</li>
                </capacities>
                <power>8</power>
                <cooldownTime>1.0</cooldownTime>
                <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
            </li>
            <li>
                <label>head</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>4</power>
                <cooldownTime>0.5</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
            </li>
        </tools>

        <killedLeavings>
            <lotr_CuspidsParrotTongue>1</lotr_CuspidsParrotTongue>
        </killedLeavings>
        <butcherProducts />

    </ThingDef>

    <PawnKindDef ParentName="AnimalKindBase">

        <defName>lotr_CuspidsParrot</defName>
        <label>Острозубый попугай</label>
        <race>lotr_CuspidsParrotRace</race>
        <combatPower>200</combatPower>
        <ecoSystemWeight>0.30</ecoSystemWeight>

        <flyingAnimationFramePathPrefix>Things/Pawn/Animal/Chicken/Chicken_Flying_</flyingAnimationFramePathPrefix>
        <flyingAnimationFrameCount>8</flyingAnimationFrameCount>
        <flyingAnimationTicksPerFrame>2</flyingAnimationTicksPerFrame>
        <flyingAnimationDrawSize>2.4</flyingAnimationDrawSize>
        <flyingAnimationDrawSizeIsMultiplier>true</flyingAnimationDrawSizeIsMultiplier>
        <flyingAnimationInheritColors>true</flyingAnimationInheritColors>
        
        <abilities>
            <li>Cast_Taunt_8S</li>
        </abilities>

        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>0.45</drawSize>
                    <color>(223,219,108)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>0.75</drawSize>
                    <color>(200,150,85)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>0.87</drawSize>
                    <color>(200,150,85)</color>
                    <shadowData>
                        <volume>(0.3, 0.4, 0.3)</volume>
                        <offset>(0,0,-0.05)</offset>
                    </shadowData>
                </bodyGraphicData>
            </li>
        </lifeStages>

    </PawnKindDef>

</Defs>