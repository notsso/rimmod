<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="AnimalThingBase">

        <defName>lotr_SerpentMonsterBirdRace</defName>
        <label>Птица-монстр с телом змеи</label>
        <description>Хищная птица, чьё тело напоминает змею, а чёрные перья источают тёмную энергию. Она бесшумно парит над болотами, высматривая добычу, и атакует с неожиданной стороны. Её перья используются в зельях пути Ассасина.</description>
        
        <statBases>
            <MoveSpeed>5.5</MoveSpeed>
            <MarketValue>300</MarketValue>
            <ComfyTemperatureMin>-25</ComfyTemperatureMin>
            <ComfyTemperatureMax>50</ComfyTemperatureMax>
            <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
            <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
            <ArmorRating_Heat>0.20</ArmorRating_Heat>
            <Wildness>1</Wildness>

            <MeatAmount>0</MeatAmount>
            <LeatherAmount>0</LeatherAmount>

            <MaxFlightTime>4</MaxFlightTime>
            <FlightCooldown>6</FlightCooldown>

            <SpiritualityOffset>0.25</SpiritualityOffset>
        </statBases>

        <race>
            <thinkTreeMain>Animal</thinkTreeMain>
            <body>Bird</body>
            <baseHungerRate>0.01</baseHungerRate>
            <baseBodySize>0.4</baseBodySize>
            <baseHealthScale>2.0</baseHealthScale>

            <foodType>OmnivoreRoughAnimal</foodType>
            <predator>true</predator>
            <trainability>None</trainability>
            <lifeExpectancy>12</lifeExpectancy>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <manhunterOnTameFailChance>1</manhunterOnTameFailChance>

            <flightStartChanceOnJobStart>1.0</flightStartChanceOnJobStart>

            <lifeStageAges>
                <li>
                    <def>AnimalBaby</def>
                    <minAge>0</minAge>
                    <soundWounded>Pawn_Chick_Call</soundWounded>
                    <soundDeath>Pawn_Chick_Call</soundDeath>
                    <soundCall>Pawn_Chick_Call</soundCall>
                    <soundAngry>Pawn_Chick_Call</soundAngry>
                </li>
                <li>
                    <def>AnimalJuvenile</def>
                    <minAge>0.15</minAge>
                </li>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0.3</minAge>
                    <soundWounded>Pawn_Chicken_Wounded</soundWounded>
                    <soundDeath>Pawn_Chicken_Death</soundDeath>
                    <soundCall>Pawn_Chicken_Call</soundCall>
                    <soundAngry>Pawn_Chicken_Angry</soundAngry>
                </li>
            </lifeStageAges>

            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
            <soundEating>Bird_Eat</soundEating>

            <headPosPerRotation>
                <li>(0.0, 0, 0.24)</li>
                <li>(0.25, 0, 0.18)</li>
                <li>(0.0, 0, 0.07)</li>
                <li>(-0.25, 0, 0.18)</li>
            </headPosPerRotation>
        </race>

        <tools>
            <li>
                <label>когти</label>
                <capacities>
                    <li>Scratch</li>
                </capacities>
                <power>8</power>
                <cooldownTime>1.0</cooldownTime>
                <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
            </li>
            <li>
                <label>клюв</label>
                <capacities>
                    <li>Bite</li>
                </capacities>
                <power>10</power>
                <cooldownTime>1.2</cooldownTime>
                <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
            </li>
            <li>
                <label>голова</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>5</power>
                <cooldownTime>0.5</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
            </li>
        </tools>

        <killedLeavings>
            <lotr_SerpentMonsterBirdFeathers>1</lotr_SerpentMonsterBirdFeathers>
        </killedLeavings>
        <butcherProducts />

    </ThingDef>

    <PawnKindDef ParentName="AnimalKindBase">

        <defName>lotr_SerpentMonsterBird</defName>
        <label>Serpent-Bodied Monster Bird</label>
        <race>lotr_SerpentMonsterBirdRace</race>
        <combatPower>130</combatPower>
        <ecoSystemWeight>0.5</ecoSystemWeight>

        <flyingAnimationFramePathPrefix>Things/Pawn/Animal/Chicken/Chicken_Flying_</flyingAnimationFramePathPrefix>
        <flyingAnimationFrameCount>8</flyingAnimationFrameCount>
        <flyingAnimationTicksPerFrame>2</flyingAnimationTicksPerFrame>
        <flyingAnimationDrawSize>1.2</flyingAnimationDrawSize>
        <flyingAnimationDrawSizeIsMultiplier>true</flyingAnimationDrawSizeIsMultiplier>
        <flyingAnimationInheritColors>true</flyingAnimationInheritColors>

        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>0.5</drawSize>
                    <color>(60,60,60)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>0.8</drawSize>
                    <color>(50,50,50)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>0.9</drawSize>
                    <color>(40,40,40)</color>
                    <shadowData>
                        <volume>(0.3, 0.4, 0.3)</volume>
                        <offset>(0,0,-0.05)</offset>
                    </shadowData>
                </bodyGraphicData>
            </li>
        </lifeStages>

    </PawnKindDef>

</Defs>