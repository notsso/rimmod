<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="AnimalThingBase">
        <defName>lotr_FlowerFacedBatRace</defName>
        <label>Flower-Faced Bat</label>
        <description>A sinister bat whose face resembles a blooming night-flower. It emits a soporific pollen that dulls the minds of its victims, leaving them vulnerable to its bite. Its head is a key ingredient for affliction potions.</description>
        
        <statBases>
            <MoveSpeed>9.0</MoveSpeed>
            <MarketValue>3000</MarketValue>
            <ComfyTemperatureMin>-80</ComfyTemperatureMin>
            <ComfyTemperatureMax>80</ComfyTemperatureMax>
            <ArmorRating_Blunt>0.80</ArmorRating_Blunt>
            <ArmorRating_Sharp>0.80</ArmorRating_Sharp>
            <ArmorRating_Heat>0.80</ArmorRating_Heat>
            <Wildness>1</Wildness>
            <MeatAmount>0</MeatAmount>
            <LeatherAmount>0</LeatherAmount>
            <Flammability>0.1</Flammability>
            <ToxicResistance>0.9</ToxicResistance>
            <ToxicEnvironmentResistance>0.9</ToxicEnvironmentResistance>
            <IncomingDamageFactor>0.7</IncomingDamageFactor>
            <InjuryHealingFactor>2.0</InjuryHealingFactor>
            <MeleeHitChance>15</MeleeHitChance>
            <MeleeDodgeChance>15</MeleeDodgeChance>
            <MaxFlightTime>8</MaxFlightTime>
            <FlightCooldown>3</FlightCooldown>
            <SpiritualityOffset>8</SpiritualityOffset>
            <PsychicSensitivity>1.2</PsychicSensitivity>
        </statBases>

        <race>
            <thinkTreeMain>Animal</thinkTreeMain>
            <body>Bird</body>
            <baseHungerRate>0.01</baseHungerRate>
            <baseBodySize>0.8</baseBodySize>
            <baseHealthScale>7.0</baseHealthScale>
            <foodType>OmnivoreRoughAnimal</foodType>
            <predator>true</predator>
            <trainability>None</trainability>
            <lifeExpectancy>80</lifeExpectancy>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <manhunterOnTameFailChance>1</manhunterOnTameFailChance>
            <flightStartChanceOnJobStart>1.0</flightStartChanceOnJobStart>
            <lifeStageAges>
                <li><def>AnimalBaby</def><minAge>0</minAge><soundWounded>Pawn_Chick_Call</soundWounded><soundDeath>Pawn_Chick_Call</soundDeath><soundCall>Pawn_Chick_Call</soundCall><soundAngry>Pawn_Chick_Call</soundAngry></li>
                <li><def>AnimalJuvenile</def><minAge>0.15</minAge></li>
                <li><def>AnimalAdult</def><minAge>0.3</minAge><soundWounded>Pawn_Chicken_Wounded</soundWounded><soundDeath>Pawn_Chicken_Death</soundDeath><soundCall>Pawn_Chicken_Call</soundCall><soundAngry>Pawn_Chicken_Angry</soundAngry></li>
            </lifeStageAges>
            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
            <soundEating>Bird_Eat</soundEating>
            <headPosPerRotation>
                <li>(0.0, 0, 0.24)</li>
                <li>(0.25, 0, 0.18)</li>
                <li>(0.0, 0, 0.07)</li>
                <li>(-0.25, 0, 0.18)</li>
            </headPosPerRotation>
        </race>

        <tools>
            <li>
                <label>claws</label>
                <capacities><li>Scratch</li></capacities>
                <power>20</power>
                <cooldownTime>1.0</cooldownTime>
                <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
                <armorPenetration>0.3</armorPenetration>
            </li>
            <li>
                <label>fangs</label>
                <capacities><li>Bite</li></capacities>
                <power>22</power>
                <cooldownTime>1.0</cooldownTime>
                <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
                <armorPenetration>0.3</armorPenetration>
            </li>
            <li>
                <label>head</label>
                <capacities><li>Blunt</li></capacities>
                <power>10</power>
                <cooldownTime>0.5</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
            </li>
        </tools>

        <butcherProducts>
            <lotr_FlowerFacedBatHead>1</lotr_FlowerFacedBatHead>
            <lotr_MysticalComponents>1</lotr_MysticalComponents>
        </butcherProducts>
    </ThingDef>

    <PawnKindDef ParentName="AnimalKindBase">
        <defName>lotr_FlowerFacedBat</defName>
        <label>Flower-Faced Bat</label>
        <race>lotr_FlowerFacedBatRace</race>
        <combatPower>900</combatPower>
        <ecoSystemWeight>0.30</ecoSystemWeight>

        <flyingAnimationFramePathPrefix>Things/Pawn/Animal/Chicken/Chicken_Flying_</flyingAnimationFramePathPrefix>
        <flyingAnimationFrameCount>8</flyingAnimationFrameCount>
        <flyingAnimationTicksPerFrame>2</flyingAnimationTicksPerFrame>
        <flyingAnimationDrawSize>1.2</flyingAnimationDrawSize>
        <flyingAnimationDrawSizeIsMultiplier>true</flyingAnimationDrawSizeIsMultiplier>
        <flyingAnimationInheritColors>true</flyingAnimationInheritColors>

        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>0.5</drawSize>
                    <color>(60,60,60)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>0.8</drawSize>
                    <color>(50,50,50)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>0.9</drawSize>
                    <color>(40,40,40)</color>
                    <shadowData>
                        <volume>(0.3, 0.4, 0.3)</volume>
                        <offset>(0,0,-0.05)</offset>
                    </shadowData>
                </bodyGraphicData>
            </li>
        </lifeStages>
    </PawnKindDef>

</Defs>