<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="AnimalThingBase">
        <defName>lotr_DemonThroatHoneyguideRace</defName>
        <label>Медовый гид из глотки демона</label>
        <description>Хитрый зверь, чей голос способен подражать любым звукам, от криков о помощи до боевых кличей. Он использует эту способность, чтобы манипулировать другими существами, заставляя их атаковать друг друга или заходить в ловушки. Его сердце переполнено энергией подстрекательства.</description>
        
        <statBases>
            <MoveSpeed>5.0</MoveSpeed>
            <MarketValue>600</MarketValue>
            <ComfyTemperatureMin>-30</ComfyTemperatureMin>
            <ComfyTemperatureMax>60</ComfyTemperatureMax>
            <ArmorRating_Blunt>0.30</ArmorRating_Blunt>
            <ArmorRating_Sharp>0.30</ArmorRating_Sharp>
            <ArmorRating_Heat>0.30</ArmorRating_Heat>
            <Wildness>1</Wildness>
            <MeatAmount>0</MeatAmount>
            <LeatherAmount>0</LeatherAmount>
            <SpiritualityOffset>0.5</SpiritualityOffset>
        </statBases>

        <race>
            <thinkTreeMain>Animal</thinkTreeMain>
            <body>QuadrupedAnimalWithPaws</body>
            <baseHungerRate>0.01</baseHungerRate>
            <baseBodySize>0.4</baseBodySize>
            <baseHealthScale>2.5</baseHealthScale>

            <foodType>OmnivoreRoughAnimal</foodType>
            <predator>true</predator>
            <trainability>None</trainability>
            <lifeExpectancy>12</lifeExpectancy>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <manhunterOnTameFailChance>1</manhunterOnTameFailChance>

            <lifeStageAges>
                <li><def>AnimalBaby</def><minAge>0</minAge></li>
                <li><def>AnimalJuvenile</def><minAge>0.1</minAge></li>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0.2</minAge>
                    <soundWounded>Pawn_Boomrat_Wounded</soundWounded>
                    <soundDeath>Pawn_Boomrat_Death</soundDeath>
                    <soundCall>Pawn_Boomrat_Call</soundCall>
                    <soundAngry>Pawn_Boomrat_Angry</soundAngry>
                </li>
            </lifeStageAges>

            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
        </race>

        <tools>
            <li>
                <label>claws</label>
                <capacities><li>Scratch</li></capacities>
                <power>8</power>
                <cooldownTime>1.0</cooldownTime>
                <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
            </li>
            <li>
                <label>claws</label>
                <capacities><li>Scratch</li></capacities>
                <power>8</power>
                <cooldownTime>1.0</cooldownTime>
                <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
            </li>
            <li>
                <label>teeth</label>
                <capacities><li>Bite</li></capacities>
                <power>10</power>
                <cooldownTime>1.2</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
            </li>
            <li>
                <label>head</label>
                <capacities><li>Blunt</li></capacities>
                <power>6</power>
                <cooldownTime>0.5</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
            </li>
        </tools>

        <killedLeavings>
            <lotr_DemonThroatHoneyguideHeart>1</lotr_DemonThroatHoneyguideHeart>
        </killedLeavings>
        <butcherProducts>
            <lotr_MysticalComponents>1</lotr_MysticalComponents>
        </butcherProducts>
    </ThingDef>

    <PawnKindDef ParentName="AnimalKindBase">
        <defName>lotr_DemonThroatHoneyguide</defName>
        <label>Demon Throat Honeyguide</label>
        <race>lotr_DemonThroatHoneyguideRace</race>
        <defaultFactionType>lotr_MysticalCreatures</defaultFactionType>
        <combatPower>200</combatPower>
        <ecoSystemWeight>0.30</ecoSystemWeight>

        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Raccoon/Raccoon</texPath>
                    <drawSize>0.6</drawSize>
                    <color>(200,20,20)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Raccoon/Raccoon</texPath>
                    <drawSize>0.9</drawSize>
                    <color>(200,20,20)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Raccoon/Raccoon</texPath>
                    <drawSize>1.1</drawSize>
                    <color>(200,20,20)</color>
                    <shadowData>
                        <volume>(0.3, 0.4, 0.3)</volume>
                        <offset>(0,0,-0.05)</offset>
                    </shadowData>
                </bodyGraphicData>
            </li>
        </lifeStages>
    </PawnKindDef>

</Defs>