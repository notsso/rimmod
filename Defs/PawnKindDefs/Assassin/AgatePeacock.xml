<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="AnimalThingBase">
        <defName>lotr_AgatePeacockRace</defName>
        <label>Агатовый павлин</label>
        <description>Великолепная птица, чьё оперение переливается, словно агат. Она источает ауру магии льда и зеркал, заставляя жертв видеть собственные отражения и терять ориентацию. Очень быстра и агрессивна, особенно защищая своё гнездо. Её яйца — ценнейший ингредиент для зелья Ведьмы.</description>
        
        <statBases>
            <MoveSpeed>6.0</MoveSpeed>
            <MarketValue>1000</MarketValue>
            <ComfyTemperatureMin>-80</ComfyTemperatureMin>
            <ComfyTemperatureMax>80</ComfyTemperatureMax>
            <ArmorRating_Blunt>0.50</ArmorRating_Blunt>
            <ArmorRating_Sharp>0.50</ArmorRating_Sharp>
            <ArmorRating_Heat>0.50</ArmorRating_Heat>
            <Wildness>1</Wildness>
            <MeatAmount>0</MeatAmount>
            <LeatherAmount>0</LeatherAmount>
            <MaxFlightTime>6</MaxFlightTime>
            <FlightCooldown>4</FlightCooldown>
            <SpiritualityOffset>3.0</SpiritualityOffset>
            <PsychicSensitivity>1.0</PsychicSensitivity>
            <ToxicResistance>0.8</ToxicResistance>
            <ToxicEnvironmentResistance>0.8</ToxicEnvironmentResistance>
        </statBases>

        <race>
            <thinkTreeMain>Animal</thinkTreeMain>
            <body>Bird</body>
            <baseHungerRate>0.01</baseHungerRate>
            <baseBodySize>0.6</baseBodySize>
            <baseHealthScale>3.5</baseHealthScale>
            <foodType>OmnivoreRoughAnimal</foodType>
            <predator>true</predator>
            <trainability>None</trainability>
            <lifeExpectancy>25</lifeExpectancy>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <manhunterOnTameFailChance>1</manhunterOnTameFailChance>
            <flightStartChanceOnJobStart>1.0</flightStartChanceOnJobStart>
            <lifeStageAges>
                <li><def>AnimalBaby</def><minAge>0</minAge><soundWounded>Pawn_Chick_Call</soundWounded><soundDeath>Pawn_Chick_Call</soundDeath><soundCall>Pawn_Chick_Call</soundCall><soundAngry>Pawn_Chick_Call</soundAngry></li>
                <li><def>AnimalJuvenile</def><minAge>0.15</minAge></li>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0.3</minAge>
                    <soundWounded>Pawn_Chicken_Wounded</soundWounded>
                    <soundDeath>Pawn_Chicken_Death</soundDeath>
                    <soundCall>Pawn_Chicken_Call</soundCall>
                    <soundAngry>Pawn_Chicken_Angry</soundAngry>
                </li>
            </lifeStageAges>
            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
            <soundEating>Bird_Eat</soundEating>
            <headPosPerRotation>
                <li>(0.0, 0, 0.24)</li>
                <li>(0.25, 0, 0.18)</li>
                <li>(0.0, 0, 0.07)</li>
                <li>(-0.25, 0, 0.18)</li>
            </headPosPerRotation>
        </race>

        <tools>
            <li>
                <label>claws</label>
                <capacities><li>Scratch</li></capacities>
                <power>14</power>
                <cooldownTime>1.0</cooldownTime>
                <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
            </li>
            <li>
                <label>beak</label>
                <capacities><li>Bite</li></capacities>
                <power>16</power>
                <cooldownTime>1.0</cooldownTime>
                <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
            </li>
            <li>
                <label>head</label>
                <capacities><li>Blunt</li></capacities>
                <power>8</power>
                <cooldownTime>0.5</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
            </li>
        </tools>

        <killedLeavings>
            <lotr_AgatePeacockEgg>1</lotr_AgatePeacockEgg>
        </killedLeavings>
        <butcherProducts>
            <lotr_MysticalComponents>1</lotr_MysticalComponents>
        </butcherProducts>
    </ThingDef>

    <PawnKindDef ParentName="AnimalKindBase">
        <defName>lotr_AgatePeacock</defName>
        <label>Agate Peacock</label>
        <race>lotr_AgatePeacockRace</race>
        <defaultFactionType>lotr_MysticalCreatures</defaultFactionType>
        <combatPower>300</combatPower>
        <ecoSystemWeight>0.40</ecoSystemWeight>

        <flyingAnimationFramePathPrefix>Things/Pawn/Animal/Chicken/Chicken_Flying_</flyingAnimationFramePathPrefix>
        <flyingAnimationFrameCount>8</flyingAnimationFrameCount>
        <flyingAnimationTicksPerFrame>2</flyingAnimationTicksPerFrame>
        <flyingAnimationDrawSize>1.2</flyingAnimationDrawSize>
        <flyingAnimationDrawSizeIsMultiplier>true</flyingAnimationDrawSizeIsMultiplier>
        <flyingAnimationInheritColors>true</flyingAnimationInheritColors>

        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>0.7</drawSize>
                    <color>(140,90,180)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>1.0</drawSize>
                    <color>(130,80,170)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>1.2</drawSize>
                    <color>(120,70,160)</color>
                    <shadowData>
                        <volume>(0.3, 0.4, 0.3)</volume>
                        <offset>(0,0,-0.05)</offset>
                    </shadowData>
                </bodyGraphicData>
            </li>
        </lifeStages>
    </PawnKindDef>

</Defs>