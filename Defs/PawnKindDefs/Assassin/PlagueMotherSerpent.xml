<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="AnimalThingBase">
        <defName>lotr_PlagueMotherSerpentRace</defName>
        <label>Plague Mother Serpent</label>
        <description>A gargantuan serpent whose very breath carries pestilence. Its scales glisten with a sickly sheen, and its venom can rot flesh in seconds. Legends say it nests in the heart of corrupted lands, birthing endless plagues. Its venom sac is a key ingredient for the Despair potion.</description>
        
        <statBases>
            <MoveSpeed>9.0</MoveSpeed>
            <MarketValue>5000</MarketValue>
            <ComfyTemperatureMin>-150</ComfyTemperatureMin>
            <ComfyTemperatureMax>150</ComfyTemperatureMax>
            <ArmorRating_Blunt>1.2</ArmorRating_Blunt>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
            <ArmorRating_Heat>1.0</ArmorRating_Heat>
            <Wildness>1</Wildness>
            <MeatAmount>0</MeatAmount>
            <LeatherAmount>0</LeatherAmount>
            <Flammability>0.0</Flammability>
            <ToxicResistance>1</ToxicResistance>
            <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
            <IncomingDamageFactor>0.4</IncomingDamageFactor>
            <InjuryHealingFactor>4.0</InjuryHealingFactor>
            <MeleeHitChance>25</MeleeHitChance>
            <MeleeDodgeChance>25</MeleeDodgeChance>
            <SpiritualityOffset>20</SpiritualityOffset>
            <PsychicSensitivity>1.0</PsychicSensitivity>
        </statBases>

        <race>
            <thinkTreeMain>Animal</thinkTreeMain>
            <body>Snake</body>
            <baseHungerRate>0.01</baseHungerRate>
            <baseBodySize>3.5</baseBodySize>
            <baseHealthScale>12.0</baseHealthScale>
            <foodType>CarnivoreAnimal</foodType>
            <predator>true</predator>
            <trainability>None</trainability>
            <lifeExpectancy>300</lifeExpectancy>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <manhunterOnTameFailChance>1</manhunterOnTameFailChance>
            <lifeStageAges>
                <li><def>AnimalBaby</def><minAge>0</minAge></li>
                <li><def>AnimalJuvenile</def><minAge>0.1</minAge></li>
                <li><def>AnimalAdult</def><minAge>0.2</minAge>
                    <soundWounded>Pawn_Cobra_Wounded</soundWounded>
                    <soundDeath>Pawn_Cobra_Death</soundDeath>
                    <soundCall>Pawn_Cobra_Call</soundCall>
                    <soundAngry>Pawn_Cobra_Angry</soundAngry>
                </li>
            </lifeStageAges>
            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
            <soundEating>Reptile_Eat</soundEating>
            <headPosPerRotation>
                <li>(-0.01, 0, 0.3)</li>
                <li>(0.35, 0, 0.05)</li>
                <li>(0.0, 0, -0.24)</li>
                <li>(-0.35, 0, 0.05)</li>
            </headPosPerRotation>
        </race>

        <tools>
            <li>
                <label>fangs</label>
                <capacities><li>ToxicBite</li></capacities>
                <power>45</power>
                <cooldownTime>1.0</cooldownTime>
                <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
                <armorPenetration>0.7</armorPenetration>
                <extraMeleeDamages>
                    <li>
                        <def>ToxicBite</def>
                        <amount>30</amount>
                    </li>
                </extraMeleeDamages>
            </li>
            <li>
                <label>head</label>
                <capacities><li>Blunt</li></capacities>
                <power>25</power>
                <cooldownTime>1.0</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
                <armorPenetration>0.4</armorPenetration>
            </li>
        </tools>

        <butcherProducts>
            <lotr_PlagueMotherSerpentVenomSac>1</lotr_PlagueMotherSerpentVenomSac>
            <lotr_MysticalComponents>3</lotr_MysticalComponents>
        </butcherProducts>
    </ThingDef>

    <PawnKindDef ParentName="AnimalKindBase">
        <defName>lotr_PlagueMotherSerpent</defName>
        <label>Plague Mother Serpent</label>
        <race>lotr_PlagueMotherSerpentRace</race>
        <combatPower>2500</combatPower>
        <ecoSystemWeight>0.10</ecoSystemWeight>

        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Cobra/Cobra</texPath>
                    <drawSize>2.5</drawSize>
                    <color>(40,60,40)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Cobra/Cobra</texPath>
                    <drawSize>4.0</drawSize>
                    <color>(30,50,30)</color>
                    <shadowData>
                        <volume>(0.3, 0.4, 0.3)</volume>
                        <offset>(0,0,-0.05)</offset>
                    </shadowData>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Cobra/Cobra</texPath>
                    <drawSize>5.5</drawSize>
                    <color>(20,40,20)</color>
                    <shadowData>
                        <volume>(0.4, 0.5, 0.4)</volume>
                        <offset>(0,0,-0.05)</offset>
                    </shadowData>
                </bodyGraphicData>
            </li>
        </lifeStages>
    </PawnKindDef>

</Defs>