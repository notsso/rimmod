<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="AnimalThingBase">
        <defName>lotr_AbyssDemonicFishRace</defName>
        <label>abyss demonic fish</label>
        <description>A nightmarish amphibious predator that lurks in the darkest swamps. Its scales shimmer with an unnatural blue glow, and its blood is thick with dark magic. It moves with eerie silence, striking from the water's edge.</description>

        <statBases>
            <MoveSpeed>3.0</MoveSpeed>
            <MarketValue>1000</MarketValue>
            <ComfyTemperatureMin>-30</ComfyTemperatureMin>
            <ComfyTemperatureMax>180</ComfyTemperatureMax>
            <ArmorRating_Blunt>0.50</ArmorRating_Blunt>
            <ArmorRating_Sharp>0.50</ArmorRating_Sharp>
            <ArmorRating_Heat>0.80</ArmorRating_Heat>
            <Wildness>1</Wildness>
            <MeatAmount>0</MeatAmount>
            <LeatherAmount>0</LeatherAmount>
            <Flammability>0</Flammability>
            <ToxicEnvironmentResistance>0.95</ToxicEnvironmentResistance>
            <SpiritualityOffset>3</SpiritualityOffset>
        </statBases>

        <race>
            <thinkTreeMain>Animal</thinkTreeMain>
            <body>QuadrupedAnimalWithClawsTailAndJowl</body>
            <baseHungerRate>0.01</baseHungerRate>
            <baseBodySize>1.8</baseBodySize>
            <baseHealthScale>4.0</baseHealthScale>
            <foodType>OmnivoreRoughAnimal</foodType>
            <predator>true</predator>
            <trainability>None</trainability>
            <lifeExpectancy>25</lifeExpectancy>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <manhunterOnTameFailChance>1</manhunterOnTameFailChance>
            <soundEating>Reptile_Eat</soundEating>

            <lifeStageAges>
                <li>
                    <def>AnimalBaby</def>
                    <minAge>0</minAge>
                </li>
                <li>
                    <def>AnimalJuvenile</def>
                    <minAge>0.1</minAge>
                </li>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0.2222</minAge>
                    <soundWounded>Pawn_Iguana_Wounded</soundWounded>
                    <soundDeath>Pawn_Iguana_Death</soundDeath>
                    <soundCall>Pawn_Iguana_Call</soundCall>
                    <soundAngry>Pawn_Iguana_Angry</soundAngry>
                </li>
            </lifeStageAges>

            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>

            <headPosPerRotation>
                <li>(-0.01, 0, 0.3)</li>
                <li>(0.35, 0, 0.05)</li>
                <li>(0.0, 0, -0.24)</li>
                <li>(-0.35, 0, 0.05)</li>
            </headPosPerRotation>
        </race>

        <tools>
            <li>
                <label>left claw</label>
                <labelNoLocation>claw</labelNoLocation>
                <capacities><li>Scratch</li></capacities>
                <power>16</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>FrontLeftClaws</linkedBodyPartsGroup>
            </li>
            <li>
                <label>right claw</label>
                <labelNoLocation>claw</labelNoLocation>
                <capacities><li>Scratch</li></capacities>
                <power>16</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>FrontRightClaws</linkedBodyPartsGroup>
            </li>
            <li>
                <capacities><li>Bite</li></capacities>
                <power>20</power>
                <cooldownTime>1.8</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
                <chanceFactor>0.7</chanceFactor>
            </li>
            <li>
                <label>head</label>
                <capacities><li>Blunt</li></capacities>
                <power>10</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
            </li>
        </tools>

        <killedLeavings>
            <lotr_AbyssDemonicFishBlood>1</lotr_AbyssDemonicFishBlood>
        </killedLeavings>
        <butcherProducts>
            <lotr_MysticalComponents>1</lotr_MysticalComponents>
        </butcherProducts>
    </ThingDef>

    <PawnKindDef ParentName="AnimalKindBase">
        <defName>lotr_AbyssDemonicFish</defName>
        <label>abyss demonic fish</label>
        <race>lotr_AbyssDemonicFishRace</race>
        <combatPower>300</combatPower>
        <ecoSystemWeight>0.80</ecoSystemWeight>

        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Iguana/Iguana</texPath>
                    <drawSize>1</drawSize>
                    <color>(50,80,180)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Iguana/Iguana</texPath>
                    <drawSize>1.25</drawSize>
                    <color>(45,70,160)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Iguana/Iguana</texPath>
                    <drawSize>1.5</drawSize>
                    <color>(40,60,140)</color>
                    <shadowData>
                        <volume>(0.25, 0.3, 0.25)</volume>
                        <offset>(0,0,0)</offset>
                    </shadowData>
                </bodyGraphicData>
            </li>
        </lifeStages>
    </PawnKindDef>

</Defs>