<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="AnimalThingBase">
        <defName>lotr_BlackWidowSpiderRace</defName>
        <label>Black Widow Spider</label>
        <description>A huge spider with glossy black chitin, whose spinnerets produce incredibly strong silk thread. This predator prefers to lie in wait for its prey in the shadows, wrapping it in a cocoon. Its spinnerets are a valuable ingredient in the Demoness of Pleasure's potions.</description>
        
        <statBases>
            <MoveSpeed>8.0</MoveSpeed>
            <MarketValue>1500</MarketValue>
            <ComfyTemperatureMin>-80</ComfyTemperatureMin>
            <ComfyTemperatureMax>80</ComfyTemperatureMax>
            <ArmorRating_Blunt>0.80</ArmorRating_Blunt>
            <ArmorRating_Sharp>0.80</ArmorRating_Sharp>
            <ArmorRating_Heat>0.90</ArmorRating_Heat>
            <Wildness>1</Wildness>
            <MeatAmount>0</MeatAmount>
            <LeatherAmount>0</LeatherAmount>
            <Flammability>0.1</Flammability>
            <ToxicResistance>1</ToxicResistance>
            <ToxicEnvironmentResistance>0.8</ToxicEnvironmentResistance>
            <IncomingDamageFactor>0.80</IncomingDamageFactor> 
            <InjuryHealingFactor>2.0</InjuryHealingFactor>
            <MeleeHitChance>10</MeleeHitChance>
            <MeleeDodgeChance>10</MeleeDodgeChance>
            <SpiritualityOffset>6</SpiritualityOffset>
        </statBases>

        <race>
            <thinkTreeMain>Insect</thinkTreeMain>
            <body>BeetleLike</body>
            <baseHungerRate>0</baseHungerRate>
            <baseBodySize>2.0</baseBodySize>
            <baseHealthScale>6.0</baseHealthScale>
            <thinkTreeConstant>InsectConstant</thinkTreeConstant>
            <fleshType>Insectoid</fleshType>
            <bloodDef>Filth_BloodInsect</bloodDef>
            <foodType>OmnivoreRoughAnimal</foodType>
            <predator>true</predator>
            <trainability>None</trainability>
            <lifeExpectancy>100</lifeExpectancy>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <manhunterOnTameFailChance>1</manhunterOnTameFailChance>
            <needsRest>false</needsRest>
            <hasGenders>false</hasGenders>
            <isImmuneToInfections>true</isImmuneToInfections>
            <bleedRateFactor>0.2</bleedRateFactor>
            <deathAction />
            <lifeStageAges>
                <li><def>EusocialInsectLarva</def><minAge>0</minAge></li>
                <li><def>EusocialInsectJuvenile</def><minAge>0.05</minAge></li>
                <li>
                    <def>EusocialInsectAdult</def>
                    <minAge>0.2</minAge>
                    <soundWounded>Pawn_Megascarab_Wounded</soundWounded>
                    <soundDeath>Pawn_Megascarab_Death</soundDeath>
                    <soundCall>Pawn_Megascarab_Call</soundCall>
                    <soundAngry>Pawn_Megascarab_Angry</soundAngry>
                </li>
            </lifeStageAges>
            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
        </race>
        
        <tools>
            <li>
                <label>mandibles</label>
                <capacities><li>Bite</li></capacities>
                <power>20</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
            </li>
            <li>
                <label>head</label>
                <capacities><li>Blunt</li></capacities>
                <power>20</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.4</chanceFactor>
            </li>
        </tools>

        <killedLeavings>
            <lotr_BlackWidowSilkGland>1</lotr_BlackWidowSilkGland>
        </killedLeavings>
        <butcherProducts>
            <lotr_MysticalComponents>1</lotr_MysticalComponents>
        </butcherProducts>
    </ThingDef>
    
    <PawnKindDef ParentName="AnimalKindBase">
        <defName>lotr_BlackWidowSpider</defName>
        <label>Black Widow Spider</label>
        <race>lotr_BlackWidowSpiderRace</race>
        <defaultFactionType>lotr_MysticalCreatures</defaultFactionType>
        <combatPower>500</combatPower>
        <ecoSystemWeight>1.00</ecoSystemWeight>
        
        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/BlackHuntingSpider/BlackHuntingSpider</texPath>
                    <drawSize>1</drawSize>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/BlackHuntingSpider/BlackHuntingSpider</texPath>
                    <drawSize>2</drawSize>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/BlackHuntingSpider/BlackHuntingSpider</texPath>
                    <drawSize>3</drawSize>
                </bodyGraphicData>
            </li>
        </lifeStages>
    </PawnKindDef>

</Defs>