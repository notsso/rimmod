<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="AnimalThingBase">

        <defName>lotr_MarshBoarRace</defName>
        <label>Болотная свинья</label>
        <description>Опасный кабан-ищейка, мутировавший под воздействием потусторонней энергии на ядовитых болотах. Обладает невероятным нюхом и огромной выносливостью. Почуяв кровь, он будет преследовать жертву километрами. Его внутренние органы подверглись частичной кристаллизации.</description>
        
        <statBases>
            <MoveSpeed>5.5</MoveSpeed>
            <MarketValue>300</MarketValue>
            <ComfyTemperatureMin>-25</ComfyTemperatureMin>
            <ComfyTemperatureMax>50</ComfyTemperatureMax>
            <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
            <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
            <ArmorRating_Heat>0.20</ArmorRating_Heat>
            <Wildness>1</Wildness> 
        </statBases>

        <race>
            <thinkTreeMain>Animal</thinkTreeMain> <!-- lotr_MarshBoarTree -->
            <body>QuadrupedAnimalWithHooves</body>
            <baseHungerRate>0.01</baseHungerRate>
            <baseBodySize>1.5</baseBodySize>
            <baseHealthScale>1.8</baseHealthScale>

            <foodType>OmnivoreRoughAnimal</foodType>
            <predator>true</predator>
            <trainability>None</trainability>
            <lifeExpectancy>15</lifeExpectancy>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <manhunterOnTameFailChance>1</manhunterOnTameFailChance>
            
            <leatherDef>Leather_Pig</leatherDef>
            <meatDef>Meat_Pig</meatDef>

            <lifeStageAges>
                <li>
                    <def>AnimalBaby</def>
                    <minAge>0</minAge>
                </li>
                <li>
                    <def>AnimalJuvenile</def>
                    <minAge>0.25</minAge>
                </li>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0.5</minAge>
                    <soundWounded>Pawn_Wildboar_Wounded</soundWounded>
                    <soundDeath>Pawn_Wildboar_Death</soundDeath>
                    <soundCall>Pawn_Wildboar_Call</soundCall>
                    <soundAngry>Pawn_Wildboar_Angry</soundAngry>
                </li>
            </lifeStageAges>

            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
            <soundEating>Herbivore_Eat</soundEating>
        </race>

        <tools>
            <li>
                <label>бивни</label>
                <capacities>
                    <li>Stab</li>
                </capacities>
                <power>14</power>
                <cooldownTime>1.8</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
            </li>
            <li>
                <label>зубы</label>
                <capacities>
                    <li>Bite</li>
                </capacities>
                <power>10</power>
                <cooldownTime>1.6</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
            </li>
        </tools>

        <butcherProducts>
            <lotr_MarshCrystal>1</lotr_MarshCrystal>
        </butcherProducts>

    </ThingDef>

    <PawnKindDef ParentName="AnimalKindBase">
    
        <defName>lotr_MarshBoar</defName>
        <label>Marsh Boar</label>
        <race>lotr_MarshBoarRace</race>
        <combatPower>120</combatPower>
        <ecoSystemWeight>0.6</ecoSystemWeight>
        
        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/MarshBoar/MarshBoar</texPath>
                    <graphicClass>Graphic_Multi</graphicClass>
                    <drawSize>2</drawSize>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/MarshBoar/MarshBoar</texPath>
                    <graphicClass>Graphic_Multi</graphicClass>
                    <drawSize>3</drawSize>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/MarshBoar/MarshBoar</texPath>
                    <graphicClass>Graphic_Multi</graphicClass>
                    <drawSize>4</drawSize>
                    <color>(200, 200, 200)</color>
                </bodyGraphicData>
            </li>
        </lifeStages>

    </PawnKindDef>

</Defs>
