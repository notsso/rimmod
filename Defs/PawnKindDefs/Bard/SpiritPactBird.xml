<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="AnimalThingBase">
        <defName>lotr_SpiritPactBirdRace</defName>
        <label>spirit pact bird</label>
        <description>A graceful bird whose feathers are used to seal sacred pacts. It exudes an aura of authority and can bind foes with magical contracts, forcing them to hesitate. Its feathers are razor-sharp when thrown.</description>

        <statBases>
            <MoveSpeed>7.0</MoveSpeed>
            <MarketValue>1500</MarketValue>
            <ComfyTemperatureMin>-80</ComfyTemperatureMin>
            <ComfyTemperatureMax>80</ComfyTemperatureMax>
            <ArmorRating_Blunt>0.70</ArmorRating_Blunt>
            <ArmorRating_Sharp>0.70</ArmorRating_Sharp>
            <ArmorRating_Heat>0.70</ArmorRating_Heat>
            <Wildness>1</Wildness>
            <MeatAmount>0</MeatAmount>
            <LeatherAmount>0</LeatherAmount>
            <MaxFlightTime>7</MaxFlightTime>
            <FlightCooldown>3</FlightCooldown>
            <Flammability>0.1</Flammability>
            <SpiritualityOffset>5.0</SpiritualityOffset>
            <PsychicSensitivity>1.5</PsychicSensitivity>
            <IncomingDamageFactor>0.85</IncomingDamageFactor>
            <InjuryHealingFactor>1.5</InjuryHealingFactor>
            <MeleeDodgeChance>0.15</MeleeDodgeChance>
        </statBases>

        <race>
            <thinkTreeMain>Animal</thinkTreeMain>
            <body>Bird</body>
            <baseHungerRate>0.01</baseHungerRate>
            <baseBodySize>1.0</baseBodySize>
            <baseHealthScale>5.0</baseHealthScale>
            <foodType>CarnivoreAnimal</foodType>
            <predator>true</predator>
            <trainability>None</trainability>
            <lifeExpectancy>150</lifeExpectancy>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <manhunterOnTameFailChance>1</manhunterOnTameFailChance>
            <flightStartChanceOnJobStart>1.0</flightStartChanceOnJobStart>

            <lifeStageAges>
                <li>
                    <def>AnimalBaby</def>
                    <minAge>0</minAge>
                </li>
                <li>
                    <def>AnimalJuvenile</def>
                    <minAge>0.2</minAge>
                </li>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0.4</minAge>
                    <soundWounded>Pawn_Chicken_Wounded</soundWounded>
                    <soundDeath>Pawn_Chicken_Death</soundDeath>
                    <soundCall>Pawn_Chicken_Call</soundCall>
                    <soundAngry>Pawn_Chicken_Angry</soundAngry>
                </li>
            </lifeStageAges>

            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
            <soundEating>Bird_Eat</soundEating>

            <headPosPerRotation>
                <li>(0.0, 0, 0.24)</li>
                <li>(0.25, 0, 0.18)</li>
                <li>(0.0, 0, 0.07)</li>
                <li>(-0.25, 0, 0.18)</li>
            </headPosPerRotation>
        </race>

        <tools>
            <li>
                <label>claws</label>
                <capacities><li>Scratch</li></capacities>
                <power>20</power>
                <cooldownTime>1.0</cooldownTime>
                <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
                <armorPenetration>0.2</armorPenetration>
            </li>
            <li>
                <label>beak</label>
                <capacities><li>Bite</li></capacities>
                <power>20</power>
                <cooldownTime>1.0</cooldownTime>
                <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
                <armorPenetration>0.5</armorPenetration>
            </li>
            <li>
                <label>feather blades</label>
                <capacities><li>Cut</li></capacities>
                <power>30</power>
                <cooldownTime>1.5</cooldownTime>
            </li>
            <li>
                <label>head</label>
                <capacities><li>Blunt</li></capacities>
                <power>20</power>
                <cooldownTime>0.8</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
            </li>
        </tools>

        <killedLeavings>
            <lotr_SpiritPactBirdFeathers>1</lotr_SpiritPactBirdFeathers>
        </killedLeavings>
        <butcherProducts>
            <lotr_MysticalComponents>1</lotr_MysticalComponents>
        </butcherProducts>
    </ThingDef>

    <PawnKindDef ParentName="AnimalKindBase">
        <defName>lotr_SpiritPactBird</defName>
        <label>spirit pact bird</label>
        <race>lotr_SpiritPactBirdRace</race>
        <combatPower>500</combatPower>
        <ecoSystemWeight>0.15</ecoSystemWeight>

        <flyingAnimationFramePathPrefix>Things/Pawn/Animal/Chicken/Chicken_Flying_</flyingAnimationFramePathPrefix>
        <flyingAnimationFrameCount>8</flyingAnimationFrameCount>
        <flyingAnimationTicksPerFrame>2</flyingAnimationTicksPerFrame>
        <flyingAnimationDrawSize>1.2</flyingAnimationDrawSize>
        <flyingAnimationDrawSizeIsMultiplier>true</flyingAnimationDrawSizeIsMultiplier>
        <flyingAnimationInheritColors>true</flyingAnimationInheritColors>

        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>0.8</drawSize>
                    <color>(180,200,220)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>1.2</drawSize>
                    <color>(160,180,210)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>1.5</drawSize>
                    <color>(140,160,200)</color>
                    <shadowData>
                        <volume>(0.3, 0.4, 0.3)</volume>
                        <offset>(0,0,-0.05)</offset>
                    </shadowData>
                </bodyGraphicData>
            </li>
        </lifeStages>
    </PawnKindDef>

</Defs>