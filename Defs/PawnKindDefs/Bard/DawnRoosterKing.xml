<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="AnimalThingBase">
        <defName>lotr_DawnRoosterKingRace</defName>
        <label>king of dawn roosters</label>
        <description>A colossal rooster whose crimson comb blazes like a second sun. It commands lesser dawn roosters and can unleash devastating waves of holy light. Its comb is a legendary ingredient for priest of light potions.</description>

        <statBases>
            <MoveSpeed>10.0</MoveSpeed>
            <MarketValue>2500</MarketValue>
            <ComfyTemperatureMin>-150</ComfyTemperatureMin>
            <ComfyTemperatureMax>150</ComfyTemperatureMax>
            <ArmorRating_Blunt>0.90</ArmorRating_Blunt>
            <ArmorRating_Sharp>0.90</ArmorRating_Sharp>
            <ArmorRating_Heat>1.00</ArmorRating_Heat>
            <Wildness>1</Wildness>
            <MeatAmount>0</MeatAmount>
            <LeatherAmount>0</LeatherAmount>
            <MaxFlightTime>5</MaxFlightTime>
            <FlightCooldown>4</FlightCooldown>
            <Flammability>0</Flammability>
            <ToxicResistance>1</ToxicResistance>
            <IncomingDamageFactor>0.70</IncomingDamageFactor>
            <InjuryHealingFactor>2.5</InjuryHealingFactor>
            <MeleeHitChance>15</MeleeHitChance>
            <MeleeDodgeChance>15</MeleeDodgeChance>
            <SpiritualityOffset>10</SpiritualityOffset>
            <PsychicSensitivity>1.5</PsychicSensitivity>
        </statBases>

        <race>
            <thinkTreeMain>Animal</thinkTreeMain>
            <body>Bird</body>
            <baseHungerRate>0.01</baseHungerRate>
            <baseBodySize>2.0</baseBodySize>
            <baseHealthScale>7.0</baseHealthScale>
            <foodType>OmnivoreRoughAnimal</foodType>
            <predator>true</predator>
            <trainability>None</trainability>
            <lifeExpectancy>500</lifeExpectancy>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <manhunterOnTameFailChance>1</manhunterOnTameFailChance>
            <flightStartChanceOnJobStart>1.0</flightStartChanceOnJobStart>

            <lifeStageAges>
                <li>
                    <def>AnimalBaby</def>
                    <minAge>0</minAge>
                </li>
                <li>
                    <def>AnimalJuvenile</def>
                    <minAge>0.2</minAge>
                </li>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0.4</minAge>
                    <soundWounded>Pawn_Chicken_Wounded</soundWounded>
                    <soundDeath>Pawn_Chicken_Death</soundDeath>
                    <soundCall>Pawn_Chicken_Call</soundCall>
                    <soundAngry>Pawn_Chicken_Angry</soundAngry>
                </li>
            </lifeStageAges>

            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
            <soundEating>Bird_Eat</soundEating>

            <headPosPerRotation>
                <li>(0.0, 0, 0.24)</li>
                <li>(0.25, 0, 0.18)</li>
                <li>(0.0, 0, 0.07)</li>
                <li>(-0.25, 0, 0.18)</li>
            </headPosPerRotation>
        </race>

        <tools>
            <li>
                <label>claws</label>
                <capacities><li>Scratch</li></capacities>
                <power>20</power>
                <cooldownTime>0.6</cooldownTime>
                <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
                <armorPenetration>0.4</armorPenetration>
            </li>
            <li>
                <label>beak</label>
                <capacities><li>Bite</li></capacities>
                <power>30</power>
                <cooldownTime>1.0</cooldownTime>
                <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
                <armorPenetration>0.5</armorPenetration>
            </li>
            <li>
                <label>head</label>
                <capacities><li>Blunt</li></capacities>
                <power>25</power>
                <cooldownTime>0.8</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
                <armorPenetration>0.3</armorPenetration>
            </li>
        </tools>

        <killedLeavings>
            <lotr_DawnRoosterKingComb>1</lotr_DawnRoosterKingComb>
        </killedLeavings>
        <butcherProducts>
            <lotr_MysticalComponents>2</lotr_MysticalComponents>
        </butcherProducts>

        <comps>
            <li Class="lotr.CompProperties_MovingGlower">
                <glowRadius>10</glowRadius>
                <glowColor>(255, 100, 20, 0)</glowColor>
            </li>
        </comps>
    </ThingDef>

    <PawnKindDef ParentName="AnimalKindBase">
        <defName>lotr_DawnRoosterKing</defName>
        <label>king of dawn roosters</label>
        <race>lotr_DawnRoosterKingRace</race>
        <defaultFactionType>lotr_MysticalCreatures</defaultFactionType>
        <combatPower>1000</combatPower>
        <ecoSystemWeight>0.05</ecoSystemWeight>

        <flyingAnimationFramePathPrefix>Things/Pawn/Animal/Chicken/Chicken_Flying_</flyingAnimationFramePathPrefix>
        <flyingAnimationFrameCount>8</flyingAnimationFrameCount>
        <flyingAnimationTicksPerFrame>2</flyingAnimationTicksPerFrame>
        <flyingAnimationDrawSize>1.0</flyingAnimationDrawSize>
        <flyingAnimationDrawSizeIsMultiplier>true</flyingAnimationDrawSizeIsMultiplier>
        <flyingAnimationInheritColors>true</flyingAnimationInheritColors>

        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>1.0</drawSize>
                    <color>(255,220,80)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>1.5</drawSize>
                    <color>(240,200,60)</color>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/Chicken/Chicken</texPath>
                    <drawSize>2.0</drawSize>
                    <color>(220,180,40)</color>
                    <shadowData>
                        <volume>(0.35, 0.45, 0.35)</volume>
                        <offset>(0,0,-0.05)</offset>
                    </shadowData>
                </bodyGraphicData>
            </li>
        </lifeStages>
    </PawnKindDef>

</Defs>