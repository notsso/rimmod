<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <ThingDef ParentName="GiantBase">
        <defName>lotr_GreyGiantRace</defName>
        <label>grey giant</label>
        <description>A monolithic grey giant, its flesh like ancient granite. It moves with ponderous inevitability and shrugs off wounds that would fell lesser beings.</description>
        <statBases>
            <MoveSpeed>8.0</MoveSpeed>
            <ArmorRating_Sharp>0.9</ArmorRating_Sharp>
            <ArmorRating_Blunt>1.0</ArmorRating_Blunt>
            <ArmorRating_Heat>0.7</ArmorRating_Heat>
            <MeleeDodgeChance>0.10</MeleeDodgeChance>
            <PsychicSensitivity>0.05</PsychicSensitivity>
        </statBases>
        <race>
            <baseBodySize>5.5</baseBodySize>
            <baseHealthScale>7.0</baseHealthScale>
        </race>
        <tools>
            <li>
                <label>left fist</label>
                <labelNoLocation>fist</labelNoLocation>
                <capacities><li>Blunt</li></capacities>
                <power>50</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
                <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
                <armorPenetration>0.5</armorPenetration>
            </li>
            <li>
                <label>right fist</label>
                <labelNoLocation>fist</labelNoLocation>
                <capacities><li>Blunt</li></capacities>
                <power>50</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
                <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
                <armorPenetration>0.5</armorPenetration>
            </li>
            <li>
                <label>teeth</label>
                <capacities><li>Bite</li></capacities>
                <power>40</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
                <chanceFactor>0.07</chanceFactor>
                <armorPenetration>0.4</armorPenetration>
            </li>
            <li>
                <label>head</label>
                <capacities><li>Blunt</li></capacities>
                <power>40</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
                <armorPenetration>0.45</armorPenetration>
            </li>
        </tools>

        <killedLeavings>
            <lotr_GrayGiantHeart>1</lotr_GrayGiantHeart>
        </killedLeavings>
        <butcherProducts>
            <lotr_MysticalComponents>2</lotr_MysticalComponents>
        </butcherProducts>
    </ThingDef>

    <PawnKindDef>
        <defName>lotr_GreyGiant</defName>
        <label>grey giant</label>
        <race>lotr_GreyGiantRace</race>
        <combatPower>2000</combatPower>
        <canMeleeAttack>true</canMeleeAttack>
        <hostileToAll>true</hostileToAll>
        <initialWillRange>0~0</initialWillRange>
        <initialResistanceRange>0~0</initialResistanceRange>
        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Giant/GreyGiant/Giant</texPath>
                    <graphicClass>Graphic_Multi</graphicClass>
                    <drawSize>7.5</drawSize>
                </bodyGraphicData>
            </li>
        </lifeStages>
        <apparelMoney>0~0</apparelMoney>
        <weaponMoney>0~0</weaponMoney>
        <nakedChance>0</nakedChance>
        <ecoSystemWeight>0</ecoSystemWeight>
        <wildGroupSize>1</wildGroupSize>
        
        <weaponTags>
            <li>GiantGreyMaul</li>
        </weaponTags>
        <weaponMoney>1500~1500</weaponMoney>
    </PawnKindDef>
</Defs>