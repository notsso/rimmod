<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="AnimalThingBase">
        
        <defName>lotr_MagmaElfRace</defName>
        <label>Magma elf</label>
        <description>Elementals born from pure fiery substance in deep underground lava lakes</description>
        
        <statBases>
            <MoveSpeed>5.0</MoveSpeed>
            <MarketValue>100</MarketValue>
            <ComfyTemperatureMin>-30</ComfyTemperatureMin>
            <ComfyTemperatureMax>180</ComfyTemperatureMax>
            <ArmorRating_Blunt>0.50</ArmorRating_Blunt>
            <ArmorRating_Sharp>0.50</ArmorRating_Sharp>
            <ArmorRating_Heat>0.80</ArmorRating_Heat>
            <Wildness>1</Wildness>

            <Flammability>0</Flammability>
            <ToxicResistance>1</ToxicResistance>
            <ToxicEnvironmentResistance>0.95</ToxicEnvironmentResistance>
        </statBases>

        <race>
            <thinkTreeMain>Animal</thinkTreeMain> <!-- lotr_FireSalamanderTree -->
            <body>QuadrupedAnimalWithPaws</body>
            <baseHungerRate>0</baseHungerRate>
            <baseBodySize>1.0</baseBodySize>
            <baseHealthScale>4.0</baseHealthScale>
            
            <foodType>OmnivoreRoughAnimal</foodType>
            <predator>true</predator>
            <trainability>None</trainability>
            <lifeExpectancy>100</lifeExpectancy>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <manhunterOnTameFailChance>1</manhunterOnTameFailChance>

            <needsRest>false</needsRest>
            <hasGenders>false</hasGenders>

            <isImmuneToInfections>true</isImmuneToInfections>
            <bleedRateFactor>0</bleedRateFactor>

            <deathAction />

            <lifeStageAges>
                <li>
                    <def>AnimalBaby</def>
                    <minAge>0</minAge>
                </li>
                <li>
                    <def>AnimalJuvenile</def>
                    <minAge>0.1</minAge>
                </li>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0.2</minAge>
                </li>
            </lifeStageAges>

        </race>
        
        <tools>
            <li>
                <label>bite</label>
                <capacities>
                    <li>Bite</li>
                </capacities>
                <power>20</power>
                <cooldownTime>1.0</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
            </li>
            <li>
                <label>head</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>20</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.5</chanceFactor>
            </li>
        </tools>

        <butcherProducts>
            <lotr_FireSalamanderGland>1</lotr_FireSalamanderGland>
        </butcherProducts>

        <comps>
            <li Class="CompProperties_Glower">
                <glowRadius>3</glowRadius>
                <glowColor>(255, 100, 20, 0)</glowColor>
            </li>
        </comps>

    </ThingDef>
    
    <PawnKindDef ParentName="AnimalKindBase">

        <defName>lotr_MagmaElf</defName>
        <label>Magma elf</label>
        <race>lotr_MagmaElfRace</race>
        <combatPower>300</combatPower>
        <ecoSystemWeight>0.80</ecoSystemWeight>

        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/MagmaElf/MagmaElf</texPath>
                    <drawSize>1</drawSize>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/MagmaElf/MagmaElf</texPath>
                    <drawSize>1.25</drawSize>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Animal/MagmaElf/MagmaElf</texPath>
                    <drawSize>1.5</drawSize>
                </bodyGraphicData>
            </li>
        </lifeStages>

    </PawnKindDef>
</Defs>