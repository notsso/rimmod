<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="Human">
        <defName>MonsterRace</defName>
        <label>lost control monster</label>
        <description>Horrifying creature born from one of those who lost control of their beyonder powers.</description>
    
        <thingClass>Pawn</thingClass>
        <category>Pawn</category>
        <selectable>true</selectable>

        <statBases>
            <Flammability>0.7</Flammability>
            <LeatherAmount>0</LeatherAmount>
            <MeatAmount>0</MeatAmount>
            <MoveSpeed>6.0</MoveSpeed>
            <ComfyTemperatureMin>-20</ComfyTemperatureMin>
            <ComfyTemperatureMax>35</ComfyTemperatureMax>
            <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
            <ArmorRating_Sharp>0.1</ArmorRating_Sharp>

            <ToxicResistance>0.5</ToxicResistance>
            <ToxicEnvironmentResistance>0.5</ToxicEnvironmentResistance>

            <IncomingDamageFactor>0.90</IncomingDamageFactor> 
            <InjuryHealingFactor>1.0</InjuryHealingFactor>
        </statBases>

        <race>
            <intelligence>Humanlike</intelligence>
            <body>Human</body>
            <baseBodySize>2.5</baseBodySize>
            <baseHealthScale>2.5</baseHealthScale>
            <needsRest>false</needsRest>
            <foodType>None</foodType>
            <hasGenders>false</hasGenders>
            <bloodDef>Filth_Blood</bloodDef>
            <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
            <leatherDef>Leather_Human</leatherDef>
            <lifeExpectancy>800</lifeExpectancy>
            <trainability>None</trainability>
            <hediffGiverSets>
                <li>OrganicStandard</li>
            </hediffGiverSets>
            <manhunterOnDamageChance>1</manhunterOnDamageChance>
            <thinkTreeMain>GiantThinkTree</thinkTreeMain>
            <thinkTreeConstant>GiantConstantThinkTree</thinkTreeConstant>
        </race>

        <tools>
            <li>
                <label>left fist</label>
                <labelNoLocation>fist</labelNoLocation>
                <capacities><li>Blunt</li></capacities>
                <power>16</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
                <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
            </li>
            <li>
                <label>right fist</label>
                <labelNoLocation>fist</labelNoLocation>
                <capacities><li>Blunt</li></capacities>
                <power>16</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
                <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
            </li>
            <li>
                <label>teeth</label>
                <capacities><li>Bite</li></capacities>
                <power>12</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
                <chanceFactor>0.07</chanceFactor>
            </li>
            <li>
                <label>head</label>
                <capacities><li>Blunt</li></capacities>
                <power>10</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
            </li>
        </tools>
    </ThingDef>

    <PawnKindDef ParentName="BasePlayerPawnKind">
        <defName>lotr_LostControlMonster</defName>
        <label>lost control monster</label>
        <race>MonsterRace</race>
        <combatPower>250</combatPower>
        <canMeleeAttack>true</canMeleeAttack>
        <hostileToAll>true</hostileToAll>
        <initialWillRange>0~0</initialWillRange>
        <initialResistanceRange>0~0</initialResistanceRange>
        <lifeStages>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/Giant/GiantWarrior/Giant</texPath>
                    <graphicClass>Graphic_Multi</graphicClass>
                    <drawSize>2.5</drawSize>
                </bodyGraphicData>
            </li>
        </lifeStages>
        <apparelMoney>0~0</apparelMoney>
        <weaponMoney>0~0</weaponMoney>
        <nakedChance>0</nakedChance>
    </PawnKindDef>
</Defs>