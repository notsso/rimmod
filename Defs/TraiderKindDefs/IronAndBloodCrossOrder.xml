<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <TraderKindDef>

        <defName>lotr_MysteryTrader</defName>
        <label>mystery trader</label>
        <stockGenerators>
            <!-- Серебро для покупок у игрока -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>500~1500</countRange>
            </li>

            <!-- Основные товары -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>lotr_MagicalHerbs</thingDef>
                <countRange>1~3</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>lotr_MysticalComponents</thingDef>
                <countRange>0~1</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>MedicineHerbal</thingDef>
                <countRange>2~5</countRange>
            </li>
            
            <!-- Товары, которые торговец хотел бы купить -->
            <li Class="StockGenerator_BuyTradeTag">
                <tag>BeyonderTrading</tag>
            </li>

            <li Class="StockGenerator_BuySingleDef">
                <thingDef>lotr_MarshCrystal</thingDef>
            </li>
        </stockGenerators>

    </TraderKindDef>
    
</Defs>