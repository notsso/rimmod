<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <FactionDef ParentName="FactionBase">
        <defName>lotr_MysticalCreatures</defName>
        <label>mystical creatures</label>
        <description>Hostile otherworldly beings that attack anyone on sight.</description>
        <pawnSingular>creature</pawnSingular>
        <pawnsPlural>creatures</pawnsPlural>
        <categoryTag>Hostile</categoryTag>

        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <settlementGenerationWeight>0</settlementGenerationWeight>
        <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
        <configurationListOrderPriority>-1</configurationListOrderPriority>
        <displayInFactionSelection>false</displayInFactionSelection>

        <fixedName>Mystical Creatures</fixedName>
        <hidden>true</hidden>
        <humanlikeFaction>false</humanlikeFaction>
        <techLevel>Animal</techLevel>

        <autoFlee>false</autoFlee>
        <canUseAvoidGrid>false</canUseAvoidGrid>
        <animalsFleeDanger>false</animalsFleeDanger>

        <permanentEnemy>true</permanentEnemy>

        <factionIconPath>World/WorldObjects/Expanding/Insects</factionIconPath>
        <basicMemberKind>Villager</basicMemberKind>

        <colorSpectrum>
            <li>(0.3, 0.0, 0.5)</li>
            <li>(0.5, 0.2, 0.8)</li>
        </colorSpectrum>

        <allowedArrivalTemperatureRange>0~45</allowedArrivalTemperatureRange>
        <pawnGroupMakers />

        <raidCommonalityFromPointsCurve>
            <points>
                <li>(0, 0)</li>
            </points>
        </raidCommonalityFromPointsCurve>

        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(100,100)</li>
                <li>(10000,10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>
    </FactionDef>
</Defs>