        <fixedName>Iron and Blood Cross Order</fixedName>
        <hidden>false</hidden>
        <humanlikeFaction>true</humanlikeFaction>
        <techLevel>Industrial</techLevel>

        <leaderTitle>semigod</leaderTitle>
        <factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
        <basicMemberKind>Villager</basicMemberKind>

        <factionNameMaker>NamerFactionOutlander</factionNameMaker>

        <colorSpectrum>
            <li>(0.45, 0.15, 0.55)</li>
            <li>(0.75, 0.45, 0.85)</li>
