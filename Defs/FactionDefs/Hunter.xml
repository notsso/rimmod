<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <FactionDef ParentName="OutlanderFactionBase">
        <defName>lotr_IronAndBloodCrossOrder</defName>
        <label>Iron and Blood Cross Order</label>
        <description>The Iron and Blood Cross Order is a newly founded secret organization that has only existed for the last 200 years. They seek to create a world under them where the mysterious and supernatural is out in the open for everyone to see, and not veiled in secrets.</description>
        <pawnSingular>member</pawnSingular>
        <pawnsPlural>members</pawnsPlural>
        <categoryTag>Outlander</categoryTag>

        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <settlementGenerationWeight>0</settlementGenerationWeight>
        <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
        <configurationListOrderPriority>-1</configurationListOrderPriority>
        <displayInFactionSelection>false</displayInFactionSelection>

        <fixedName>Iron and Blood Cross Order</fixedName>
        <hidden>false</hidden>
        <humanlikeFaction>true</humanlikeFaction>
        <techLevel>Industrial</techLevel>

        <leaderTitle>semigod</leaderTitle>
        <factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
        <basicMemberKind>Villager</basicMemberKind>

        <factionNameMaker>NamerFactionOutlander</factionNameMaker>

        <colorSpectrum>
            <li>(0.45, 0.15, 0.55)</li>
            <li>(0.75, 0.45, 0.85)</li>
        </colorSpectrum>

        <factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>

        <backstoryFilters>
            <li>
                <categories><li>Outlander</li></categories>
                <commonality>1</commonality>
            </li>
        </backstoryFilters>

        <pawnGroupMakers>
            <!-- группа торговцев -->
            <li>
                <kindDef>Peaceful</kindDef>
                <options>
                    <Villager>10</Villager>
                </options>
            </li>

            <!-- Боевые отряды (для рейдов) -->
            <li>
                <kindDef>Combat</kindDef>
                <commonality>100</commonality>
                <options>
                    <Mercenary_Slasher>5</Mercenary_Slasher>
                    <Mercenary_Gunner>5</Mercenary_Gunner>
                    <Mercenary_Elite>5</Mercenary_Elite>

                    <Beyonder_Hunter9>10</Beyonder_Hunter9>
                    <Beyonder_Hunter8>8</Beyonder_Hunter8>
                    <Beyonder_Hunter7>6</Beyonder_Hunter7>
                    <Beyonder_Hunter6>4</Beyonder_Hunter6>
                    <Beyonder_Hunter5>2</Beyonder_Hunter5>
                    <Beyonder_Hunter4>1</Beyonder_Hunter4>
                </options>
            </li>

            <!-- Гарнизон для защиты поселений (у нас их нет, но оставим на будущее) -->
            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <Town_Guard>10</Town_Guard>
                    <Mercenary_Gunner>10</Mercenary_Gunner>
                    <Mercenary_Elite>10</Mercenary_Elite>
                </options>
            </li>
        </pawnGroupMakers>

        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>

        <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
        <visitorTraderKinds />
        <caravanTraderKinds />
        <baseTraderKinds />
    </FactionDef>
</Defs>