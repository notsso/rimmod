<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <RecipeDef>
        <defName>StrengthPotionRecipe</defName>
        <label>brew strength potion</label>
        <description>Brew a mysterious potion.</description>
        <jobString>Brewing potion.</jobString>
        
        <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
        <workSkill>Intellectual</workSkill>
        <effectWorking>Cook</effectWorking>
        <soundWorking>Recipe_Drug</soundWorking>
        <workAmount>100</workAmount>
    
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>MedicineHerbal</li>
                    </thingDefs>
                </filter>
                <count>3</count>
            </li>
        </ingredients>
        
        <products>
            <lotr_StrengthPotion>1</lotr_StrengthPotion>
        </products>
        
        <recipeUsers>
            <li>DrugLab</li>
        </recipeUsers>
        
        <researchPrerequisite>Brewing</researchPrerequisite>
    </RecipeDef>

