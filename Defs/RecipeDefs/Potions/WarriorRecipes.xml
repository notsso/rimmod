<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <RecipeDef>
        <defName>Warrior9_PotionRecipe</defName>
        <label>brew Warrior's potion</label>
        <description>Brew a mysterious potion of the Warrior pathway.</description>
        <jobString>Brewing Warrior's potion.</jobString>
        
        <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
        <workSkill>Intellectual</workSkill>
        <effectWorking>Cook</effectWorking>
        <soundWorking>Recipe_Drug</soundWorking>
        <workAmount>100</workAmount>
    
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>lotr_GiantWarriorCore</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>MedicineHerbal</li>
                    </thingDefs>
                </filter>
                <count>5</count>
            </li>
        </ingredients>
        
        <products>
            <Warrior9_Potion>1</Warrior9_Potion>
        </products>
        
        <recipeUsers>
            <li>DrugLab</li>
        </recipeUsers>
        
        <researchPrerequisite>Brewing</researchPrerequisite>
    </RecipeDef>

